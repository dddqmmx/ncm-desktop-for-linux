import { RuntimeState } from "../state/runtime.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { SettingsModal } from "settings_modal.slint";

// src/main/api/service/uiService.ts: a separate, resizable settings window.
export component SettingsWindow inherits Window {
    title: "设置 · NCM Desktop for Linux";
    icon: Icons.app-logo;
    preferred-width: 1000px;
    preferred-height: 800px;
    out property <length> minimum-window-width: 1000px;
    out property <length> minimum-window-height: 800px;
    min-width: root.minimum-window-width;
    min-height: root.minimum-window-height;
    no-frame: true;
    resize-border-width: 6px;
    background: Theme.sys-bg;
    in-out property <bool> presented: false;
    callback close-settings();
    changed presented => { if self.presented { keyboard-focus.focus(); } }

    property <float> settings-opacity: root.presented ? 1 : 0;
    property <length> settings-offset-y: root.presented ? 0px : 16px;
    animate settings-opacity, settings-offset-y {
        duration: 500ms;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1.0);
    }
    keyboard-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.close-settings(); return accept; }
            return reject;
        }
        settings-modal-container := SettingsModal {
            x: 0px;
            y: root.settings-offset-y;
            width: 100%; height: 100%;
            opacity: root.settings-opacity;
            close-settings => { root.close-settings(); }
        }
    }
    if RuntimeState.runtime-enabled && RuntimeState.runtime-message != "" : Rectangle {
        x: 244px; y: parent.height - 52px; width: parent.width - 264px; height: 36px;
        background: Theme.glass-fill-strong; border-radius: 10px;
        Text { x: 12px; width: parent.width - 24px; height: parent.height; text: RuntimeState.runtime-message; color: Theme.sys-text; font-size: 12px; overflow: elide; vertical-alignment: center; }
        TouchArea { clicked => { RuntimeState.runtime-message = ""; } }
    }

}
