export component SaturationField inherits Rectangle {
    in property <float> hue;
    in-out property <float> saturation;
    in-out property <float> value;
    callback selected();
    background: @linear-gradient(90deg, #ffffff 0%, hsv(root.hue, 1, 1) 100%);
    Rectangle {
        width: 100%; height: 100%;
        background: @linear-gradient(180deg, transparent 0%, #000000 100%);
    }
    Rectangle {
        x: Math.clamp(root.saturation * parent.width - 6px, 0px, parent.width - 12px);
        y: Math.clamp((1 - root.value) * parent.height - 6px, 0px, parent.height - 12px);
        width: 12px; height: 12px; border-radius: 6px;
        border-width: 2px; border-color: #ffffff;
        background: hsv(root.hue, root.saturation, root.value);
    }
    saturation-touch := TouchArea {
        mouse-cursor: crosshair;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) || (event.kind == PointerEventKind.move && self.pressed) {
                root.saturation = Math.clamp(self.mouse-x / self.width, 0, 1);
                root.value = 1 - Math.clamp(self.mouse-y / self.height, 0, 1);
                root.selected();
            }
        }
    }
}

export component HueField inherits Rectangle {
    in-out property <float> hue;
    callback selected();
    border-radius: 8px;
    HorizontalLayout {
        spacing: 0px;
        for index in 6 : Rectangle {
            background: @linear-gradient(90deg, hsv(index * 60, 1, 1) 0%, hsv((index + 1) * 60, 1, 1) 100%);
        }
    }
    Rectangle {
        x: Math.clamp(root.hue / 360 * parent.width - 4px, 0px, parent.width - 8px);
        y: -2px; width: 8px; height: 20px;
        border-radius: 4px; border-width: 2px; border-color: #ffffff;
        background: hsv(root.hue, 1, 1);
    }
    hue-touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) || (event.kind == PointerEventKind.move && self.pressed) {
                root.hue = Math.clamp(self.mouse-x / self.width, 0, 1) * 360;
                root.selected();
            }
        }
    }
}
