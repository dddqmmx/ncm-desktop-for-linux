import { RuntimeState } from "../state/runtime.slint";
import { AudioState } from "../state/audio.slint";
import { Theme } from "../theme.slint";

import { ModernSwitch, VolumeRow, SegmentedSlider3 } from "../components/common.slint";
import { Dropdown } from "../components/dropdown.slint";

import { SettingsText, SettingGroupCard, SettingRowItem } from "controls.slint";

component OutputDevicePicker inherits HorizontalLayout {

    spacing: 12px;

    device-select := Dropdown {
        y: 0px;
        option-count: AudioState.output-devices.length;
        option-label(index) => { return AudioState.output-devices[index].name; }
        current-index: AudioState.setting-output-device-index;
        placeholder: AudioState.setting-output-device-label;
        popup-width: 320px;
        selected(index) => {
            if RuntimeState.runtime-enabled {
                RuntimeState.runtime-action("select-device", -1, AudioState.output-devices[index].id);
            } else {
                AudioState.setting-output-device-index = index;
                AudioState.setting-output-device-label = AudioState.output-devices[index].name;
                AudioState.setting-supports-exclusive = index == 0;
            }
        }
    }

    Rectangle {
        width: 78px;
        height: 36px;
        y: 0px;
        border-radius: 10px;
        background: ref-ta.has-hover ? Theme.sys-control-hover : Theme.sys-control;

        ref-ta := TouchArea { mouse-cursor: pointer; clicked => { RuntimeState.runtime-action("devices", -1, ""); } }

        SettingsText {
            text: "刷新设备";
            font-size: 13px;
            font-weight: 600;
            color: Theme.sys-text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component AudioSettingsTab inherits VerticalLayout {
    SettingGroupCard {
        title: "音频质量";

        SettingRowItem {
            title: "默认播放音质";
            action-width: 240px;
            action-height: 36px;
            description: "选择流媒体播放或下载的默认音质级别";
            show-divider: false;

            quality-select := Dropdown {
                y: 0px;
                option-count: AudioState.sound-quality-options.length;
                option-label(index) => { return AudioState.sound-quality-options[index].label; }
                current-index: AudioState.setting-sound-quality-index;
                popup-width: 280px;
                selected(index) => {
                    AudioState.setting-sound-quality = AudioState.sound-quality-options[index].value;
                }
            }
        }
    }

    SettingGroupCard {
        title: "输出架构";
        no-card: true;
        tip: RuntimeState.runtime-enabled
            ? "当前 Slint 客户端仅支持 Native 原生输出，暂不支持切换 WebAPI / Auto。"
            : "Native 提供高性能原生输出；WebAPI 适合兼容性场景。当前设备切换由 Native 输出链路生效。";

        SegmentedSlider3 {
            label-0: "Native";
            value-0: "native";
            label-1: "WebAPI";
            value-1: "webapi";
            label-2: "Auto";
            value-2: "auto";
            current-value <=> AudioState.setting-audio-engine;
            enabled: !RuntimeState.runtime-enabled;
        }
    }

    SettingGroupCard {
        title: "音量控制";

        SettingRowItem {
            title: "软件音量";
            description: "允许应用进行数字音量调节；开启严格 BitPerfect 时禁用";
            show-divider: true;

            software-volume-switch := ModernSwitch {
                y: 0px;
                checked: AudioState.setting-software-volume && !AudioState.setting-strict-bitperfect;
                enabled: !AudioState.setting-strict-bitperfect;
                toggled(v) => { AudioState.setting-software-volume = v; }
            }
        }

        SettingRowItem {
            title: "应用音量";
            action-width: 266px;
            action-height: 20px;
            description: "仅调节本应用的输出音量，不影响系统音量";
            show-divider: false;

            application-volume := VolumeRow {
                volume <=> AudioState.volume-percent;
                disabled: !AudioState.can-adjust-volume;
                slider-width: 220px;
            }
        }
    }

    SettingGroupCard {
        title: "设备选择";

        SettingRowItem {
            title: "指定输出设备";
            action-width: 330px;
            action-height: 36px;
            description: "选择系统默认输出或一个真实硬件端点";
            show-divider: true;

            device-picker := OutputDevicePicker {

            }
        }

        SettingRowItem {
            title: "当前设备";
            action-width: Math.min(280px, dev-txt.preferred-width + 24px);
            action-height: 32px;
            description: "显示原生播放器当前正在使用的输出端点";
            show-divider: true;

            Rectangle {
                height: 32px;
                width: Math.min(280px, dev-txt.preferred-width + 24px);
                y: 0px;
                border-radius: 10px;
                background: Theme.sys-surface-muted;

                dev-txt := SettingsText {
                    x: 12px;
                    width: parent.width - 24px;
                    overflow: elide;
                    text: AudioState.setting-output-device-label;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.sys-text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        SettingRowItem {
            title: "独占输出模式";
            description: AudioState.setting-supports-exclusive
                ? "仅 Native 输出可用；严格 BitPerfect 打开时会强制启用"
                : "当前输出不支持独占；已保存的设置可以关闭，选择硬件端点后才能开启";
            show-divider: true;

            exclusive-switch := ModernSwitch {
                y: 0px;
                checked: AudioState.setting-strict-bitperfect || AudioState.setting-exclusive-mode;
                enabled: !AudioState.setting-strict-bitperfect && (AudioState.setting-exclusive-mode
                    || (AudioState.setting-supports-exclusive && AudioState.setting-audio-engine != "webapi"));
                toggled(v) => { AudioState.setting-exclusive-mode = v; }
            }
        }

        SettingRowItem {
            title: "严格 BitPerfect";
            description: AudioState.setting-supports-exclusive
                ? "仅 Native 输出可用；设备必须原生支持当前音源格式"
                : "当前输出不支持 BitPerfect；已保存的设置可以关闭，选择 hw: 硬件端点后才能开启";
            show-divider: false;

            bitperfect-switch := ModernSwitch {
                y: 0px;
                checked <=> AudioState.setting-strict-bitperfect;
                // Unsupported outputs block enabling, but must allow clearing a saved preference.
                enabled: AudioState.setting-strict-bitperfect
                    || (AudioState.setting-supports-exclusive && AudioState.setting-audio-engine != "webapi");
            }
        }
    }
}
