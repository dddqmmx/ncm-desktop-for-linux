import { Theme } from "../theme.slint";
import { AppIcon } from "../components/common.slint";

export component AuxVisibilityButton inherits Rectangle {
    in property <bool> shown: true;
    in property <image> icon;
    in property <bool> hovered: false;
    callback toggled();
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: root.hovered ? Theme.sys-control-hover : transparent;
    opacity: root.shown ? 1.0 : 0.34;
    animate opacity, background { duration: 200ms; easing: ease; }
    if !root.shown : Image {
        width: 100%; height: 100%;
        source: @image-url("../../assets/icons/aux-hidden-ring.svg");
        colorize: Theme.sys-border-strong;
    }
    AppIcon {
        x: 8px; y: 8px;
        source: root.icon;
        icon-size: 18px;
        tint: Theme.sys-text;
    }
}
