import { SettingsState } from "../state/settings.slint";
import { FullscreenControlsPreview } from "fullscreen_controls_preview.slint";
import { AccentColorPicker } from "accent_color_picker.slint";
import { Theme } from "../theme.slint";

import { ModernSwitch, SegmentedSlider3 } from "../components/common.slint";

import { SettingsText, SettingGroupCard, SettingRowItem } from "controls.slint";

export component AppearanceSettingsTab inherits VerticalLayout {
    SettingGroupCard {
        title: "色彩模式";
        no-card: true;

        SegmentedSlider3 {
            label-0: "浅色模式";
            value-0: "light";
            label-1: "深色模式";
            value-1: "dark";
            label-2: "跟随系统";
            value-2: "adaptive";
            current-value <=> Theme.theme-mode;
            selected(mode) => {
                Theme.is-dark = (mode == "dark");
            }
        }
    }

    SettingGroupCard {
        title: "视觉效果";

        SettingRowItem {
            title: "亚克力 / 云母效果";
            description: "启用窗口半透明磨砂背景";
            show-divider: true;

            ModernSwitch {
                y: 0px;
                checked <=> SettingsState.setting-acrylic;
            }
        }

        SettingRowItem {
            title: "强调色";
            action-width: 40px;
            action-height: 24px;
            description: "用于后续主题扩展和重点控件着色";
            show-divider: false;

            accent-picker := AccentColorPicker {

            }
        }
    }

    SettingGroupCard {
        title: "全屏播放页";

        VerticalLayout {
            padding-top: 18px;
            padding-bottom: 6px;
            spacing: 12px;

            player-preview := FullscreenControlsPreview {

            }

            SettingsText {
                text: "拖动按钮可跨左右两侧移动并调整顺序，点击按钮切换显示 / 隐藏；虚线圈表示当前已隐藏。音量按钮仅在开启软件音量后出现。";
                font-size: 11px;
                color: Theme.sys-text-tertiary;
                wrap: word-wrap;
            }
        }
    }
}
