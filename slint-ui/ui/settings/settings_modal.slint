import { SettingsState } from "../state/settings.slint";
import { AboutSettingsTab } from "about_tab.slint";
import { DebugSettingsTab } from "debug_tab.slint";
import { ShortcutsSettingsTab } from "shortcuts_tab.slint";
import { CacheSettingsTab } from "cache_tab.slint";
import { LibrarySettingsTab } from "library_tab.slint";
import { AppearanceSettingsTab } from "appearance_tab.slint";
import { AudioSettingsTab } from "audio_tab.slint";
import { GeneralSettingsTab } from "general_tab.slint";
import { SettingsText, SettingsNavBtn } from "controls.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";

import { AppIcon } from "../components/common.slint";

component SettingsTabContent inherits Flickable {

    content-width: self.width;
    content-height: tab-col.preferred-height;
    property <string> displayed-tab: SettingsState.settings-tab;
    changed displayed-tab => { self.content-y = 0px; }

    tab-col := VerticalLayout {
        width: 100%;
        padding-top: 16px;
        padding-left: 40px;
        padding-right: 40px;
        padding-bottom: 48px;
        spacing: 0px;

        // 1. 通用 (GeneralSettingsTab.vue)
        if SettingsState.settings-tab == "general" : GeneralSettingsTab { }

        // 2. 音频输出 (AudioSettingsTab.vue)
        if SettingsState.settings-tab == "audio" : AudioSettingsTab { }

        // 3. 外观个性化 (AppearanceSettingsTab.vue)
        if SettingsState.settings-tab == "appearance" : AppearanceSettingsTab { }

        // 4. 曲库管理 (LibrarySettingsTab.vue)
        if SettingsState.settings-tab == "library" : LibrarySettingsTab { }

        // 5. 缓存 (CacheSettingsTab.vue)
        if SettingsState.settings-tab == "cache" : CacheSettingsTab { }

        // 6. 快捷键 (ShortcutsSettingsTab.vue)
        if SettingsState.settings-tab == "shortcuts" : ShortcutsSettingsTab { }

        // 7. 调试 (DebugSettingsTab.vue)
        if SettingsState.settings-tab == "debug" : DebugSettingsTab { }

        // 8. 关于软件 (AboutSettingsTab.vue)
        if SettingsState.settings-tab == "about" : AboutSettingsTab { }
    }
}

component SettingsHeader inherits Rectangle {
    in property <string> active-tab-title;
    callback close-settings();

    height: header-layout.preferred-height;
    // Native moves may consume the release event. WindowMoveArea
    // starts after the drag threshold without retaining a mouse grab.
    WindowMoveArea { width: 100%; height: 100%; }

    header-layout := HorizontalLayout {
        padding-left: 40px;
        padding-right: 40px;
        padding-top: 28px;
        padding-bottom: 16px;
        spacing: 16px;
        cross-axis-alignment: center;
        settings-header-h2 := Rectangle {

            horizontal-stretch: 1;
            height: header-title.preferred-height;

            header-title := SettingsText {
                width: 100%;
                height: 100%;
                text: root.active-tab-title;
                font-size: 28px;
                font-weight: 700;
                color: Theme.sys-text;
                vertical-alignment: center;
            }
        }
        settings-close-btn := Rectangle {
            accessible-role: button;
            accessible-label: "关闭设置";
            accessible-action-default => { root.close-settings(); }

            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: close-set-ta.has-hover ? Theme.sys-control-hover : Theme.sys-control;
            border-width: 1px;
            border-color: Theme.sys-border;
            animate background { duration: 300ms; easing: cubic-bezier(0.25, 0.8, 0.25, 1.0); }

            close-set-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close-settings(); }
            }

            AppIcon {
                x: 9px;
                y: 9px;
                source: Icons.close;
                icon-size: 18px;
                tint: close-set-ta.has-hover ? Theme.sys-text : Theme.sys-text-secondary;
            }
        }
    }
}

component SettingsSidebar inherits Rectangle {
    in property <int> active-tab-index;

    background: Theme.sys-surface-muted;

    settings-brand := Rectangle {
        x: 16px;
        y: 32px;
        width: parent.width - 32px;
        height: brand-row.preferred-height + 32px;

        brand-row := HorizontalLayout {
            x: 16px;
            width: parent.width - 32px;
            spacing: 10px;
            cross-axis-alignment: center;
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.theme-color; }
            SettingsText {

                text: "SETTINGS";
                font-size: 11px;
                font-weight: 800;
                color: Theme.sys-text-tertiary;
                vertical-alignment: center;
            }
        }
    }

    // 导航列表 + 滑动指示器 (.sidebar-nav: x = 1 + 16 = 17, y = 1 + 32 + 49.59 = 82.59, width = 240 - 1 - 32 = 207)
    Rectangle {
        x: 16px;
        y: settings-brand.y + settings-brand.height;
        width: parent.width - 32px - 1px;
        height: parent.height - self.y - 32px;

        // .nav-indicator (height 44px, step 52px, transition transform 0.4s cubic-bezier(0.2, 1, 0.3, 1))
        settings-nav-indicator := Rectangle {
            x: 0px;
            y: root.active-tab-index * 52px;
            width: 100%;
            height: 44px;
            border-radius: 10px;
            background: Theme.sys-control-selected;
            border-width: 1px;
            border-color: Theme.sys-border;
            animate y { duration: 400ms; easing: cubic-bezier(0.2, 1.0, 0.3, 1.0); }

            Rectangle {
                x: 4px;
                y: 12px;
                width: 4px;
                height: 20px;
                border-radius: 2px;
                background: Theme.theme-color;
            }
        }

        VerticalLayout {
            spacing: 8px;
            alignment: start;

            settings-nav-general := SettingsNavBtn {
                tab-id: "general";
                label: "通用";
                icon: Icons.settings-general;
                active: SettingsState.settings-tab == "general";
                clicked => { SettingsState.settings-tab = "general"; }
            }
            settings-nav-audio := SettingsNavBtn {
                tab-id: "audio";
                label: "音频输出";
                icon: Icons.settings-audio;
                active: SettingsState.settings-tab == "audio";
                clicked => { SettingsState.settings-tab = "audio"; }
            }
            settings-nav-appearance := SettingsNavBtn {
                tab-id: "appearance";
                label: "外观个性化";
                icon: Icons.settings-appearance;
                active: SettingsState.settings-tab == "appearance";
                clicked => { SettingsState.settings-tab = "appearance"; }
            }
            settings-nav-library := SettingsNavBtn {
                tab-id: "library";
                label: "曲库管理";
                icon: Icons.settings-library;
                active: SettingsState.settings-tab == "library";
                clicked => { SettingsState.settings-tab = "library"; }
            }
            settings-nav-cache := SettingsNavBtn {
                tab-id: "cache";
                label: "缓存";
                icon: Icons.settings-cache;
                active: SettingsState.settings-tab == "cache";
                clicked => { SettingsState.settings-tab = "cache"; }
            }
            settings-nav-shortcuts := SettingsNavBtn {
                tab-id: "shortcuts";
                label: "快捷键";
                icon: Icons.settings-shortcuts;
                active: SettingsState.settings-tab == "shortcuts";
                clicked => { SettingsState.settings-tab = "shortcuts"; }
            }
            settings-nav-debug := SettingsNavBtn {
                tab-id: "debug";
                label: "调试";
                icon: Icons.settings-debug;
                active: SettingsState.settings-tab == "debug";
                clicked => { SettingsState.settings-tab = "debug"; }
            }
            settings-nav-about := SettingsNavBtn {
                tab-id: "about";
                label: "关于软件";
                icon: Icons.settings-about;
                active: SettingsState.settings-tab == "about";
                clicked => { SettingsState.settings-tab = "about"; }
            }
        }
    }

    // 右边框分隔线
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.sys-border;
    }
}

component SettingsMain inherits Rectangle {
    in property <string> active-tab-title;
    callback close-settings();

    background: Theme.sys-surface;

    // .main-header (x=241, y=1, width=1193, height=88.8, padding 28px 40px 16px)
    settings-main-header := SettingsHeader {
        x: 0px;
        y: 0px;
        width: 100%;
        active-tab-title: root.active-tab-title;
        close-settings => { root.close-settings(); }
    }

    // 内容滚动区 (.content-scroll: x=241, y=89.8, width=1193, height=909.2, padding 16px 40px 48px)
    settings-content-scroll := SettingsTabContent {
        x: 0px;
        y: settings-main-header.height;
        width: 100%;
        height: parent.height - settings-main-header.height;
    }
}

export component SettingsModal inherits Rectangle {
    callback close-settings();
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.28);

    property <int> active-tab-index:
        SettingsState.settings-tab == "general" ? 0 :
        SettingsState.settings-tab == "audio" ? 1 :
        SettingsState.settings-tab == "appearance" ? 2 :
        SettingsState.settings-tab == "library" ? 3 :
        SettingsState.settings-tab == "cache" ? 4 :
        SettingsState.settings-tab == "shortcuts" ? 5 :
        SettingsState.settings-tab == "debug" ? 6 : 7;

    property <string> active-tab-title:
        SettingsState.settings-tab == "general" ? "通用" :
        SettingsState.settings-tab == "audio" ? "音频输出" :
        SettingsState.settings-tab == "appearance" ? "外观个性化" :
        SettingsState.settings-tab == "library" ? "曲库管理" :
        SettingsState.settings-tab == "cache" ? "缓存" :
        SettingsState.settings-tab == "shortcuts" ? "快捷键" :
        SettingsState.settings-tab == "debug" ? "调试" : "关于软件";

    // .settings-window.liquid-glass (SettingsModal.vue:151 width: 100%, height: 100%, border-radius: 20px, border: 1px)
    settings-window := Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        border-radius: 20px;
        background: @linear-gradient(135deg, Theme.sys-surface-strong 0%, Theme.sys-surface 100%);
        border-width: 1px;
        border-color: Theme.sys-border;
        clip: true;

        TouchArea {}

        // 1px 边框内部容器 (x=1, y=1, width=1433, height=998)
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;

            // 左侧侧边栏 (.settings-sidebar: x=1, y=1, width=240, height=998, padding 32px 16px, border-right 1px)
            settings-sidebar := SettingsSidebar {
                x: 0px;
                y: 0px;
                width: 240px;
                height: 100%;
                active-tab-index: root.active-tab-index;
            }

            // 右侧主内容区 (.settings-main: x=241, y=1, width=1193, height=998)
            settings-main := SettingsMain {
                x: 240px;
                y: 0px;
                width: parent.width - 240px;
                height: 100%;
                active-tab-title: root.active-tab-title;
                close-settings => { root.close-settings(); }
            }
        }
    }
}
