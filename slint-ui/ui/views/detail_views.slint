import { RuntimeState } from "../state/runtime.slint";
import { NavigationState } from "../state/navigation.slint";
import { AccountState } from "../state/account.slint";
import { PlaylistState } from "../state/playlist.slint";
import { DetailState } from "../state/detail.slint";
import { SongMenuState } from "../state/song_menu.slint";
import { FlowText, ClampedText } from "../components/typography.slint";
import { MediaDetailActions } from "detail_actions.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { TrackItem } from "../models.slint";
import { RoundedCover } from "../components/common.slint";
import { SongList } from "../components/media.slint";
import { SkeletonBlock } from "../components/skeleton.slint";

// 对应 MediaDetailLayout.vue 通用头部 + 列表布局
component MediaDetailInfo inherits VerticalLayout {
    function open-artist() {
        if RuntimeState.runtime-enabled { RuntimeState.runtime-action("artist", -1, ""); } else { NavigationState.current-route = "artist"; }
    }

    in property <string> variant;
    in property <[string]> meta;
    in property <string> description;

    spacing: 12px;
    alignment: start;

    // Creator slot (歌单创建者头像+昵称 或 专辑歌手名)
    if root.variant == "playlist" : HorizontalLayout {
        height: 28px;
        spacing: 8px;
        alignment: start;

        RoundedCover {
            width: 28px;
            height: 28px;
            radius: 14px;
            source: PlaylistState.playlist-creator-avatar;
        }

        Text {
            text: PlaylistState.playlist-creator;
            font-size: 14px;
            font-weight: 700;
            color: Theme.sys-text;
            vertical-alignment: center;
        }
    }

    if root.variant == "album" : HorizontalLayout {
        height: 22px;
        alignment: start;
        Rectangle {
            height: 22px;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-artist(); }
            }
            Text {
                text: DetailState.album-artist;
                font-size: 14px;
                font-weight: 700;
                color: Theme.sys-text;
                vertical-alignment: center;
            }
        }
    }

    // .stats-row (gap 8px, dot 4x4)
    HorizontalLayout {
        height: self.preferred-height;
        spacing: 8px;
        alignment: start;

        for m[idx] in root.meta : HorizontalLayout {
            spacing: 8px;
            alignment: start;

            FlowText {
                text: m;
                font-size: 14px;
                font-weight: 500;
                color: Theme.sys-text-secondary;
                vertical-alignment: center;
            }

            if idx < root.meta.length - 1 : Rectangle {
                width: 4px;
                height: 4px;
                y: (parent.height - self.height) / 2;
                border-radius: 2px;
                background: Theme.sys-text-disabled;
            }
        }
    }

    if root.description != "" : FlowText {
        width: root.width * 0.9;
        text: root.description;
        font-size: 14px;
        color: Theme.sys-text-secondary;
        wrap: word-wrap;
        max-lines: 2;
        overflow: elide;
    }
}

component MediaDetailHeader inherits Rectangle {
    in property <string> variant;
    in property <string> title;
    in property <string> description;
    in property <[string]> meta;
    in property <image> cover;
    in property <string> search-placeholder;
    in property <[TrackItem]> songs;
    in property <bool> loading;
    in property <bool> metadata-loading;
    in property <string> load-error;
    in property <bool> force-search-focus;
    property <bool> stacked: root.width < 720px;
    property <length> details-width: root.width - (root.stacked ? 0px : 320px);
    property <length> header-height: root.stacked
        ? detail-cover-wrapper.height + 40px + details.height
        : Math.max(detail-cover-wrapper.height, details.height);

    height: root.header-height;

    // 左侧 280x280 封面 (.cover-wrapper: x=316, y=40, width=280, height=280, border-radius 12px)
    detail-cover-wrapper := RoundedCover {
        x: 0px;
        y: 0px;
        width: root.stacked ? 200px : 280px;
        height: self.width;
        radius: 12px;
        source: root.cover;
        is-local-fallback: root.variant == "local";
        fallback-icon-size: 112px;
        drop-shadow-blur: 44px;
        drop-shadow-offset-y: 18px;
        drop-shadow-color: Theme.sys-shadow-elevated;
    }

    if root.variant == "playlist" && root.cover.width == 0 : SkeletonBlock {
        animated: root.load-error == "";
        x: detail-cover-wrapper.x;
        y: detail-cover-wrapper.y;
        width: detail-cover-wrapper.width;
        height: detail-cover-wrapper.height;
        border-radius: 12px;
    }

    // 右侧详情与底部操作栏 (.playlist-details: x = 280 + 40 = 320px -> window x=636, width=749, height=280)
    details := Rectangle {
        x: root.stacked ? 0px : detail-cover-wrapper.width + 40px;
        y: root.stacked ? detail-cover-wrapper.height + 40px : 0px;
        width: root.details-width;
        height: Math.max(root.stacked ? 0px : detail-cover-wrapper.height,
            detail-title.y + detail-title.height + 12px + info.preferred-height + 24px + detail-action-bar.height);
        detail-title := Rectangle {
            x: 0px;
            y: 4px;
            width: 100%;
            height: title-text.height;
            clip: true;

            title-text := ClampedText {
                width: root.details-width;
                line-height: 1.2;
                text: root.title == "" && root.load-error != "" ? "歌单" : root.title;
                font-size: 42px;
                font-weight: 800;
                text-color: Theme.sys-text;
                max-lines: 2;
            }
            if root.metadata-loading && root.title == "" : SkeletonBlock {
                width: parent.width * 0.75;
                height: 38px;
                y: (parent.height - self.height) / 2;
            }
        }
        info := MediaDetailInfo {
            visible: !root.metadata-loading;
            x: 0px;
            y: detail-title.y + detail-title.height + 12px;
            width: 100%;
            variant: root.variant;
            meta: root.meta;
            description: root.description;
        }

        if root.metadata-loading : VerticalLayout {
            x: 0px;
            y: detail-title.y + detail-title.height + 12px;
            width: 100%;
            spacing: 12px;
            alignment: start;
            HorizontalLayout {
                height: 28px;
                spacing: 8px;
                alignment: start;
                SkeletonBlock { width: 28px; height: 28px; border-radius: 14px; }
                SkeletonBlock { width: 120px; height: 14px; y: 7px; }
            }
            SkeletonBlock { width: 200px; height: 16px; }
            Rectangle { height: 8px; }
            SkeletonBlock { width: parent.width * 0.9; height: 14px; }
            SkeletonBlock { width: parent.width * 0.6; height: 14px; }
        }

        if root.metadata-loading : HorizontalLayout {
            x: 0px;
            y: parent.height - detail-action-bar.height;
            height: 44px;
            spacing: 10px;
            alignment: start;
            SkeletonBlock { width: 144px; height: 44px; border-radius: 22px; }
            SkeletonBlock { width: 120px; height: 44px; border-radius: 22px; }
        }

        // 底部操作栏 (.action-bar: y = 280 - 44 = 236px -> window y=276, height 44px, gap 16px)
        detail-action-bar := MediaDetailActions {
            visible: !root.metadata-loading;
            x: 0px;
            y: parent.height - detail-action-bar.height;
            width: parent.width;

            variant: root.variant;
            songs: root.songs;
            force-search-focus: root.force-search-focus;
            loading: root.loading;
            load-error: root.load-error;
            search-placeholder: root.search-placeholder;
        }
    }
}

export component MediaDetailView inherits Rectangle {
    in property <string> variant: "playlist"; // "playlist" | "album" | "favorites" | "local"
    in property <string> title;
    in property <string> description;
    in property <[string]> meta: [];
    in property <image> cover: Icons.cover-indigo;
    in property <string> search-placeholder: "在歌单内搜索...";
    in property <[TrackItem]> songs: [];
    in property <bool> loading: false;
    in property <bool> metadata-loading: false;
    in property <string> load-error;
    in-out property <bool> force-search-focus: false;

    width: 100%;
    height: 100%;
    property <int> playlist-id: PlaylistState.active-playlist-id;
    changed playlist-id => {
        if root.variant == "playlist" {
            DetailState.detail-search-query = "";
            detail-scroll.content-y = 0px;
        }
    }
    changed loading => { if root.loading { detail-scroll.content-y = 0px; } }
    property <string> search-query: DetailState.detail-search-query;
    property <[TrackItem]> visible-songs: root.variant == "playlist" && root.search-query != ""
        ? DetailState.filter-tracks(root.songs, root.search-query) : root.songs;
    changed search-query => {
        SongMenuState.close-menu();
        detail-scroll.content-y = 0px;
    }

    // .playlist-container: width 1149px (1159 - 10px scrollbar), max-width 1200px, padding 40px
    property <length> avail-w: root.width - 10px;
    property <length> container-w: Math.min(self.avail-w, 1200px);
    property <length> container-x: (self.avail-w - self.container-w) / 2;

    detail-scroll := Flickable {
        width: 100%;
        height: 100%;
        content-width: root.width;
        content-height: detail-container.height;
        changed content-y => {
            SongMenuState.close-menu();
            PlaylistState.is-playlist-actions-open = false;
        }
        changed content-height => { self.content-y = Math.max(Math.min(0px, self.height - self.content-height), Math.min(0px, self.content-y)); }

        detail-container := Rectangle {
            x: root.container-x;
            y: 0px;
            width: root.container-w;
            height: 40px + detail-header.height + 48px + song-list.preferred-height + 120px;

            // .playlist-header (x = +40px -> window x=316, y=40, width=1069, height=280, gap=40px)
            detail-header := MediaDetailHeader {
                x: 40px;
                y: 40px;
                width: parent.width - 80px;
                variant: root.variant;
                title: root.title;
                description: root.description;
                meta: root.meta;
                cover: root.cover;
                search-placeholder: root.search-placeholder;
                songs: root.songs;
                loading: root.loading;
                metadata-loading: root.metadata-loading;
                load-error: root.load-error;
                force-search-focus: root.force-search-focus;
            }

            // 歌曲列表组件 (x=316, y = 40 + 280 + 48 = 368px, width=1069)
            song-list := SongList {
                x: 40px;
                y: 40px + detail-header.height + 48px;
                width: parent.width - 80px;
                songs: root.visible-songs;
                searching: root.variant == "playlist" && root.search-query != "" && root.songs.length > 0;
                loading: root.loading;
                load-error: root.load-error;
                retry => { PlaylistState.open-playlist(PlaylistState.active-playlist-id); }
                viewport-top: detail-scroll.absolute-position.y - self.absolute-position.y;
                viewport-height: detail-scroll.height;
                is-local-variant: root.variant == "local";
                show-remove-from-playlist: root.variant == "playlist" && PlaylistState.playlist-owned && AccountState.is-logged-in;
            }
        }
    }
}
