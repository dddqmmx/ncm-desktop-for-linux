import { RuntimeState } from "../state/runtime.slint";
import { PlayerState } from "../state/player.slint";
import { SongMenuState } from "../state/song_menu.slint";
import { DetailState } from "../state/detail.slint";
import { SearchState } from "../state/search.slint";
import { FlowText } from "../components/typography.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { CategoryItem, TrackItem } from "../models.slint";
import { AppIcon, RoundedCover } from "../components/common.slint";
import { VirtualRows } from "../components/virtual_rows.slint";

// 对应 SearchView.vue .category-card (height 100px, border-radius 12px, padding 16px, hover scale(1.02) 0.2s)
component SearchInputField inherits Rectangle {

    width: 100%;
    height: 48px;
    border-radius: SearchState.search-is-floating ? 24px : 14px;
    background: SearchState.search-is-floating ? Theme.glass-fill : Theme.sys-surface-strong;
    border-width: 1px;
    border-color: SearchState.search-is-floating ? Theme.glass-border : Theme.sys-border;
    drop-shadow-blur: SearchState.search-is-floating ? 36px : 12px;
    drop-shadow-offset-y: SearchState.search-is-floating ? 14px : 4px;
    drop-shadow-color: SearchState.search-is-floating ? Theme.glass-shadow : rgba(0, 0, 0, 0.04);
    animate border-radius { duration: 300ms; easing: ease; }

    AppIcon {
        x: 16px;
        y: 15px;
        source: Icons.search-line;
        icon-size: 18px;
        tint: Theme.sys-text-tertiary;
    }

    search-input := TextInput {
        x: 44px;
        y: 0px;
        width: parent.width - 88px;
        height: 48px;
        text <=> SearchState.search-query;
        font-size: 16px;
        color: Theme.sys-text;
        vertical-alignment: center;
        single-line: true;
        accepted => {
            SearchState.search-show-results = SearchState.search-query != "";
            if RuntimeState.runtime-enabled { RuntimeState.runtime-action("search", -1, ""); }
        }
    }

    if SearchState.search-query == "" && !search-input.has-focus : Text {
        x: 44px;
        y: 0px;
        height: 48px;
        text: "搜索歌曲、 艺人、专辑、歌词、歌单";
        font-size: 16px;
        color: Theme.sys-text-tertiary;
        vertical-alignment: center;
    }

    if SearchState.search-query != "" : Rectangle {
        x: parent.width - 36px;
        y: 10px;
        width: 28px;
        height: 28px;

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                SearchState.search-query = "";
                SearchState.search-show-results = false;
            }
        }

        AppIcon {
            x: 4px;
            y: 4px;
            source: Icons.close;
            icon-size: 20px;
            tint: Theme.sys-text-tertiary;
        }
    }
}

component SearchSongActions inherits HorizontalLayout {
    in property <TrackItem> song;
    in property <bool> is-hovered;
    out property <bool> hovered: fav-ta.has-hover || more-ta.has-hover;
    spacing: 10px;
    alignment: end;

    Rectangle {
        width: 28px;
        height: 28px;
        y: (parent.height - self.height) / 2;
        border-radius: 14px;
        background: fav-ta.has-hover ? Theme.sys-control-hover : transparent;
        opacity: (root.song.is-favorite || root.is-hovered) ? 1.0 : 0.0;
        animate opacity, background { duration: 200ms; easing: ease; }

        fav-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if RuntimeState.runtime-enabled { PlayerState.toggle-favorite(root.song.id); } else if (PlayerState.current-song-id == root.song.id) {
                    PlayerState.toggle-favorite(PlayerState.current-song-id);
                }
            }
        }

        AppIcon {
            x: 6px;
            y: 6px;
            source: root.song.is-favorite ? Icons.heart-fill : Icons.heart;
            icon-size: 16px;
            tint: (root.song.is-favorite || fav-ta.has-hover) ? Theme.theme-color-strong : Theme.sys-text-disabled;
        }
    }

    Text {
        text: root.song.duration;
        font-size: 13px;
        color: Theme.sys-text-tertiary;
        vertical-alignment: center;
    }

    Rectangle {
        width: 28px;
        height: 28px;
        y: (parent.height - self.height) / 2;

        more-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                SongMenuState.open-menu-anchor-right = self.absolute-position.x + self.width;
                SongMenuState.open-menu-anchor-top = self.absolute-position.y;
                SongMenuState.open-menu-anchor-bottom = self.absolute-position.y + self.height;
                SongMenuState.open-menu-song-id = root.song.id;
                SongMenuState.open-menu-song-name = root.song.name;
                SongMenuState.open-menu-show-remove = false;
                SongMenuState.open-menu-submenu = false;
            }
        }

        Text {
            text: "•••";
            font-size: 13px;
            color: (SongMenuState.open-menu-song-id == root.song.id || more-ta.has-hover) ? Theme.sys-text : Theme.sys-text-tertiary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component CategoryCard inherits Rectangle {
    in property <CategoryItem> cat;
    in-out property <bool> force-hover: false;
    callback clicked();

    height: 100px;
    border-radius: 12px;
    clip: true;

    property <bool> is-hovered: card-ta.has-hover || root.force-hover;
    property <float> card-scale: self.is-hovered ? 1.02 : 1.0;
    animate card-scale { duration: 200ms; easing: ease; }

    background: root.cat.color-type == "purple"
        ? @linear-gradient(135deg, Theme.theme-color 0%, Theme.theme-color-strong 100%)
        : (root.cat.color-type == "orange"
        ? @linear-gradient(135deg, Theme.sys-category-warm 0%, Theme.sys-category-sun 100%)
        : (root.cat.color-type == "red"
        ? @linear-gradient(135deg, Theme.sys-danger 0%, Theme.sys-category-red 100%)
        : (root.cat.color-type == "blue"
        ? @linear-gradient(135deg, Theme.sys-category-cyan 0%, Theme.sys-category-sky 100%)
        : (root.cat.color-type == "green"
        ? @linear-gradient(135deg, Theme.sys-success 0%, Theme.sys-category-mint 100%)
        : (root.cat.color-type == "dark"
        ? @linear-gradient(135deg, #3b4254 0%, #1e2330 100%)
        : (root.cat.color-type == "pink"
        ? @linear-gradient(135deg, Theme.theme-color-strong 0%, Theme.sys-category-rose 100%)
        : @linear-gradient(135deg, Theme.theme-color 0%, Theme.sys-category-ink 100%)))))));

    card-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    card-decoration := Rectangle {
        width: 60px; height: 60px;
        x: parent.width - self.width + 10px;
        y: parent.height - self.height + 10px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.20);
        transform-rotation: 25deg;
    }

    category-name := Text {
        x: 16px;
        y: 20px;
        text: root.cat.name;
        font-size: 18px;
        font-weight: 700;
        color: Theme.sys-on-accent;
    }
}

component SearchCategories inherits VerticalLayout {
    property <length> inner-w: root.width;
    property <int> category-columns: Math.max(1, Math.floor((root.width + 16px) / 196px));
    spacing: 0px;

    Rectangle { height: 24px; }

    Rectangle {
        height: browse-heading.height;
        browse-heading := FlowText {
            width: 100%;
            text: "专区";
            font-size: 20px;
            font-weight: 700;
            color: Theme.sys-text;
            vertical-alignment: center;
        }
    }

    Rectangle { height: 16px; }

    browse-grid := FlexboxLayout {
        width: root.inner-w;
        spacing: 16px;
        alignment: start;
        for category in SearchState.browse-categories : CategoryCard {
            width: (root.inner-w - (root.category-columns - 1) * 16px) / root.category-columns;
            cat: category;
            clicked => {
                SearchState.search-query = category.name;
                SearchState.search-show-results = true;
                if RuntimeState.runtime-enabled { RuntimeState.runtime-action("search", -1, ""); }
            }
        }
    }
}

component SearchQueryBar inherits Rectangle {

    height: 48px;

    property <length> target-bar-w: SearchState.search-is-floating
        ? Math.min(root.width, 500px)
        : Math.min(root.width, 600px);
    property <length> target-bar-x: SearchState.search-is-floating
        ? (root.width - self.target-bar-w) / 2
        : 0px;

    search-bar-wrapper := Rectangle {
        x: parent.target-bar-x;
        y: 0px;
        width: parent.target-bar-w;
        height: 48px;
        animate x, width { duration: 400ms; easing: ease; }

        search-input-box := SearchInputField {

        }
    }
}

component SearchResultSongRow inherits Rectangle {
    in property <TrackItem> song;

    property <bool> is-hovered: row-ta.has-hover || song-actions.hovered;

    height: 64px;
    background: root.is-hovered ? Theme.sys-control-hover : transparent;
    animate background { duration: 200ms; easing: ease; }

    row-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            PlayerState.play-song(root.song.id, root.song.name, root.song.artist, root.song.cover, false, true);
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        alignment: space-between;

        // .song-left (gap 12px)
        HorizontalLayout {
            spacing: 12px;
            horizontal-stretch: 1;

            RoundedCover {
                cover-id: root.song.id;
                width: 44px;
                height: 44px;
                radius: 8px;
                source: root.song.cover;
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: root.song.name;
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.sys-text;
                    overflow: elide;
                }

                Text {
                    text: root.song.artist + " · " + root.song.album;
                    font-size: 12px;
                    color: Theme.sys-text-secondary;
                    overflow: elide;
                }
            }
        }

        // .song-right (gap 10px)
        song-actions := SearchSongActions {
            song: root.song;
            is-hovered: root.is-hovered;
        }
    }
}

component SearchResults inherits VerticalLayout {
    in property <length> viewport-top;
    in property <length> viewport-height;

    padding-top: 24px;
    spacing: 16px;

    HorizontalLayout {
        alignment: space-between;

        Text {
            text: "歌曲 (" + DetailState.detail-tracks.length + ")";
            font-size: 20px;
            font-weight: 700;
            color: Theme.sys-text;
        }

        Rectangle {
            width: 84px;
            height: 28px;
            border-radius: 14px;
            background: Theme.sys-control;

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    SearchState.search-query = "";
                    SearchState.search-show-results = false;
                }
            }

            Text {
                text: "返回专区";
                font-size: 12px;
                font-weight: 600;
                color: Theme.sys-text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // .songs-list (background sys-surface-muted, border-radius 16px)
    search-results := VirtualRows {
        row-count: DetailState.detail-tracks.length;
        row-height: 64px;
        viewport-top: root.viewport-top - self.absolute-position.y;
        viewport-height: root.viewport-height;
        border-radius: 16px;
        background: Theme.sys-surface-muted;
        clip: true;

        for offset in search-results.slot-count : SearchResultSongRow {
            property <int> target-index: search-results.row-index(offset);
            property <int> item-index: -1;
            init => { self.item-index = self.target-index; }
            changed target-index => { self.item-index = self.target-index; }
            visible: item-index < search-results.end-row;
            y: (item-index) * search-results.row-height;
            width: parent.width;
            song: DetailState.detail-tracks[item-index];
        }
    }

    // .bottom-observer (.no-more)
    Rectangle {
        height: 60px;
        TouchArea { enabled: RuntimeState.runtime-enabled && DetailState.detail-tracks.length < SearchState.search-result-count; mouse-cursor: pointer; clicked => { RuntimeState.runtime-action("more-search", -1, ""); } }
        Text {
            text: RuntimeState.runtime-enabled && DetailState.detail-tracks.length < SearchState.search-result-count ? "加载更多" : "没有更多了";
            font-size: 13px;
            color: Theme.sys-text-disabled;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component SearchView inherits Rectangle {
    width: 100%;
    height: 100%;

    search-scroll := Flickable {
        width: 100%;
        height: 100%;
        content-width: root.width;
        content-height: search-col.preferred-height;
        changed content-y => { SongMenuState.close-menu(); }
        changed content-height => { self.content-y = Math.max(Math.min(0px, self.height - self.content-height), Math.min(0px, self.content-y)); }

        search-col := VerticalLayout {
            width: root.width;
            padding-left: 24px;
            padding-right: 24px;
            padding-bottom: 120px;
            spacing: 0px;

            // === 头部搜索栏容器 (.search-header) ===
            // .page-title: margin-top 10px, font-size 34px, weight 800, margin-bottom 20px, transition all 0.3s ease
            Rectangle {
                height: SearchState.search-is-floating ? 10px : 10px;
            }

            search-page-title := Rectangle {
                height: SearchState.search-is-floating ? 0px : page-heading.height;
                opacity: SearchState.search-is-floating ? 0.0 : 1.0;
                clip: true;
                animate height, opacity { duration: 300ms; easing: ease; }

                page-heading := FlowText {
                    width: 100%;
                    text: "搜索";
                    font-size: 34px;
                    font-weight: 800;
                    color: Theme.sys-text;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: SearchState.search-is-floating ? 0px : 20px;
                animate height { duration: 300ms; easing: ease; }
            }

            // .search-bar-wrapper (normal: x=300, y=84.39, width=600, height=48; floating: max-width 500px, centered, transition all 0.4s ease)
            query-bar := SearchQueryBar {

            }

            if !SearchState.search-show-results : SearchCategories {

            }

            // === 状态 2: 搜索结果 (.results-section) ===
            if SearchState.search-show-results : SearchResults {
                viewport-top: search-scroll.absolute-position.y;
                viewport-height: search-scroll.height;

            }
        }
    }
}
