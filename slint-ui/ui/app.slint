import { RuntimeState } from "state/runtime.slint";
import { NavigationState } from "state/navigation.slint";
import { LoginState } from "state/login.slint";
import { QueueState } from "state/queue.slint";
import { PlayerViewState } from "state/player_view.slint";
import { DialogState } from "state/dialog.slint";
import { SongMenuState } from "state/song_menu.slint";
import { DownloadState } from "state/download.slint";
import { PlaylistState } from "state/playlist.slint";
import { DetailState } from "state/detail.slint";
import { LibraryState } from "state/library.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";

import { SideNavBar } from "components/sidebar.slint";
import { PlayerBar } from "components/player_bar.slint";
import { PlayerFullscreen } from "components/player_fullscreen.slint";
import { HomeView } from "views/home_view.slint";
import { SearchView } from "views/search_view.slint";
import { MediaDetailView } from "views/detail_views.slint";
import { ArtistView } from "views/artist_view.slint";
import { DownloadModal, SongContextMenuOverlay, AddToPlaylistModal, LoginModal, AppDialogModal } from "overlays/modals.slint";
export { SettingsWindow } from "settings/settings_window.slint";
export { LoginCaptureWindow } from "overlays/login_modal.slint";
import { PlaylistEditor, PlaylistActionsOverlay } from "overlays/playlist_editor.slint";

export { Theme }
export {
    RuntimeState, NavigationState, AccountState, LoginState,
    AudioState, SettingsState, PlayerState, QueueState, PlayerViewState,
    DialogState, SongMenuState, DownloadState, PlaylistState, DetailState,
    LibraryState, HomeState, SearchState, ArtistState,
} from "state.slint";

component WindowControls inherits HorizontalLayout {
    callback window-action(string);

    spacing: 4px;
    for action in ["minimize", "maximize", "close"] : Rectangle {
        width: 32px; height: 26px; border-radius: 6px;
        background: button.has-hover ? Theme.sys-control-hover : transparent;
        accessible-role: AccessibleRole.button;
        accessible-label: action == "minimize" ? "最小化" : action == "maximize" ? "最大化或还原" : "关闭";
        accessible-action-default => { root.window-action(action); }
        button := TouchArea { mouse-cursor: pointer; clicked => { root.window-action(action); } }
        if action == "minimize" : Rectangle { x: 10px; y: 13px; width: 12px; height: 1px; background: Theme.sys-text-secondary; }
        if action == "maximize" : Rectangle { x: 10px; y: 7px; width: 12px; height: 12px; border-width: 1px; border-color: Theme.sys-text-secondary; border-radius: 2px; }
        if action == "close" : Image { x: 8px; y: 5px; width: 16px; height: 16px; source: Icons.close; colorize: Theme.sys-text-secondary; }
    }
}

component DismissPlayerOverlays inherits TouchArea {

    width: 100%;
    height: 100%;
    clicked => {
        QueueState.is-playlist-open = false;
        PlayerViewState.is-volume-popup-open = false;
    }
}

export component AppWindow inherits Window {
    title: "NCM Desktop for Linux";
    icon: Icons.app-logo;
    preferred-width: 1435px;
    preferred-height: 1000px;
    min-width: 1340px;
    min-height: 960px;
    no-frame: true;
    resize-border-width: 6px;
    background: Theme.sys-bg;
    callback window-action(string);

    changed width => { NavigationState.window-width = self.width; }
    changed height => { NavigationState.window-height = self.height; }

    // 全屏播放器进出场过渡 (MainView.vue:127-138 .player-fade: opacity 0.35s ease, transform translateY(20px) 0.35s ease)
    property <float> fullscreen-opacity: PlayerViewState.is-fullscreen ? 1.0 : 0.0;
    property <length> fullscreen-offset-y: PlayerViewState.is-fullscreen ? 0px : 20px;
    animate fullscreen-opacity, fullscreen-offset-y { duration: 350ms; easing: ease; }

    // 全局确认弹窗过渡 (AppDialog.vue:120 .dialog-fade: opacity 0.18s ease)
    property <float> dialog-opacity: DialogState.is-dialog-open ? 1.0 : 0.0;
    animate dialog-opacity { duration: 180ms; easing: ease; }

    // 登录弹窗过渡 (SideNavBar.vue:380 .modal-fade: opacity 0.3s)
    property <float> login-opacity: LoginState.is-login-open ? 1.0 : 0.0;
    animate login-opacity { duration: 300ms; easing: ease; }

    // 应用主背景层 (--app-background)
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.app-background;
        clip: true;

        // 左上角与右下角柔和主题色径向光晕 (对应 base.css radial-gradient)
        Rectangle {
            x: -180px;
            y: -180px;
            width: 680px;
            height: 680px;
            border-radius: 340px;
            background: @radial-gradient(circle, Theme.theme-color-soft 0%, transparent 70%);
        }

        Rectangle {
            x: parent.width - 480px;
            y: parent.height - 480px;
            width: 640px;
            height: 640px;
            border-radius: 320px;
            background: @radial-gradient(circle, Theme.theme-color-soft 0%, transparent 70%);
        }

        // 底层主布局 (.app-layout: 进入全屏 350ms 动画结束前保持可见，退出全屏立即恢复)
        if root.fullscreen-opacity < 0.999 : HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 0px;

            // 左侧浮动玻璃导航栏
            sidebar-nav := SideNavBar {
                height: 100%;
            }

            // 右侧主内容区 (.content-area-blended)
            content-area := Rectangle {
                horizontal-stretch: 1;
                height: 100%;
                clip: true;

                // 路由视图区
                if NavigationState.current-route == "home" : home-view := HomeView {
                    width: 100%;
                    height: 100%;
                }

                if NavigationState.current-route == "search" : search-view := SearchView {
                    width: 100%;
                    height: 100%;
                }

                if NavigationState.current-route == "playlist" : playlist-view := MediaDetailView {
                    width: 100%;
                    height: 100%;
                    variant: "playlist";
                    loading: PlaylistState.playlist-loading;
                    metadata-loading: PlaylistState.playlist-metadata-loading;
                    load-error: PlaylistState.playlist-load-error;
                    title: PlaylistState.playlist-title;
                    description: PlaylistState.playlist-description;
                    meta: PlaylistState.playlist-meta;
                    cover: PlaylistState.playlist-cover;
                    search-placeholder: "在歌单内搜索...";
                    songs: PlaylistState.playlist-tracks;
                }

                if NavigationState.current-route == "album" : album-view := MediaDetailView {
                    width: 100%;
                    height: 100%;
                    variant: "album";
                    title: DetailState.album-title;
                    description: DetailState.album-description;
                    meta: DetailState.album-meta;
                    cover: DetailState.album-cover;
                    search-placeholder: "在专辑内搜索...";
                    songs: DetailState.detail-tracks;
                }

                if NavigationState.current-route == "favorites" : favorites-view := MediaDetailView {
                    width: 100%;
                    height: 100%;
                    variant: "favorites";
                    title: "喜欢的音乐";
                    description: DetailState.favorite-description;
                    meta: [DetailState.detail-tracks.length + " 首歌曲"];
                    cover: DetailState.favorite-cover;
                    search-placeholder: "在喜欢的音乐中搜索...";
                    songs: DetailState.detail-tracks;
                }

                if NavigationState.current-route == "local-music" : local-music-view := MediaDetailView {
                    width: 100%;
                    height: 100%;
                    variant: "local";
                    title: "本地音乐";
                    description: LibraryState.local-description;
                    meta: [LibraryState.local-tracks.length + " 首歌曲"];
                    cover: Icons.cover-cyan;
                    search-placeholder: "在本地音乐中搜索...";
                    songs: LibraryState.local-tracks;
                }

                if NavigationState.current-route == "artist" : artist-view := ArtistView {
                    width: 100%;
                    height: 100%;
                }

                // 点击页面收起待播浮层/音量浮层的遮罩层
                if QueueState.is-playlist-open || PlayerViewState.is-volume-popup-open : DismissPlayerOverlays {

                }

                // 底部液态玻璃播放器条 + 待播列表浮层
                player-bar := PlayerBar {
                    width: 100%;
                    height: 100%;
                }
            }
        }

        // Overlay the empty top inset so the page Flickable cannot capture drags.
        WindowMoveArea { x: 0px; y: 0px; width: 100%; height: 30px; }

        // Compact controls replace the buttons removed with the system frame.
        window-controls := WindowControls {
            x: parent.width - 112px;
            y: 4px;
            width: 104px;
            height: 26px;
            window-action(action) => { root.window-action(action); }
        }

        // 歌曲上下文菜单浮层 (SongContextMenu)
        if SongMenuState.open-menu-song-id >= 0 : context-menu-overlay := SongContextMenuOverlay {
            width: 100%;
            height: 100%;
        }

        // 添加到歌单弹窗 (AddToPlaylistModal)
        if SongMenuState.is-add-to-playlist-open : add-to-playlist-modal := AddToPlaylistModal {
            width: 100%;
            height: 100%;
        }

        if DownloadState.is-download-open : DownloadModal { width: 100%; height: 100%; }

        // 登录弹窗 (LoginModal: modal-fade 300ms ease)
        login-modal-container := LoginModal {
            width: 100%;
            height: 100%;
            opacity: root.login-opacity;
            visible: LoginState.is-login-open || root.login-opacity > 0.01;
        }

        // 全屏播放器挂载点 (PlayerFullscreen: player-fade 350ms ease, translateY(20px -> 0))
        fullscreen-container := PlayerFullscreen {
            presented: PlayerViewState.is-fullscreen || root.fullscreen-opacity > 0.01;
            x: 0px;
            y: root.fullscreen-offset-y;
            width: 100%;
            height: 100%;
            opacity: root.fullscreen-opacity;
            visible: PlayerViewState.is-fullscreen || root.fullscreen-opacity > 0.01;
        }

        // 全局确认对话框 (AppDialog: dialog-fade 180ms ease)
        PlaylistActionsOverlay {
            width: 100%; height: 100%;
        }
        if PlaylistState.playlist-editor-mode != "" : PlaylistEditor {
            width: 100%; height: 100%;
        }

        dialog-modal-container := AppDialogModal {
            width: 100%;
            height: 100%;
            opacity: root.dialog-opacity;
            visible: DialogState.is-dialog-open || root.dialog-opacity > 0.01;
        }
    }
    if RuntimeState.runtime-enabled && RuntimeState.runtime-message != "" : Rectangle {
        x: 382px;
        y: parent.height - 154px;
        width: parent.width - 450px;
        height: 42px;
        border-radius: 12px;
        background: Theme.glass-fill-strong;
        border-width: 1px;
        border-color: Theme.sys-border;
        Text {
            x: 16px; width: parent.width - 44px; height: parent.height;
            text: RuntimeState.runtime-message;
            font-size: 13px; color: Theme.sys-text; vertical-alignment: center; overflow: elide;
        }
        TouchArea { clicked => { RuntimeState.runtime-message = ""; } }
    }

}
