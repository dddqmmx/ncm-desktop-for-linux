import { RuntimeState } from "../state/runtime.slint";
import { PlayerState } from "../state/player.slint";
import { PlayerViewState } from "../state/player_view.slint";
import { Icons } from "../icons.slint";

import { AppIcon, PlaybackSpinner } from "common.slint";

export component FullscreenTransport inherits Rectangle {
    in property <color> text-color;
    in property <color> btn-bg;
    in property <color> btn-text;
    in property <color> contrast-color;
    width: 200px;
    height: 72px;

    public function previous() {
        if RuntimeState.runtime-enabled { PlayerState.step-song(-1); }
        else if PlayerViewState.active-lyric-index > 0 { PlayerViewState.active-lyric-index -= 1; }
    }
    public function next() {
        if RuntimeState.runtime-enabled { PlayerState.step-song(1); }
        else if PlayerViewState.active-lyric-index < PlayerViewState.lyrics.length - 1 { PlayerViewState.active-lyric-index += 1; }
    }

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        spacing: 40px;
        alignment: center;

        // 上一首
        Rectangle {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            opacity: prev-ta.has-hover ? 1.0 : 0.8;

            prev-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.previous();
                }
            }

            AppIcon {
                source: Icons.prev;
                icon-size: 24px;
                tint: root.text-color;
            }
        }

        // 72x72 主播放按钮 (.play-main-btn: x=337.75, y=835.48, 72x72, transition transform 0.2s, background 0.5s)
        fullscreen-play-btn := Rectangle {
            width: 72px;
            height: 72px;
            border-radius: 36px;
            background: root.btn-bg;
            animate background { duration: 500ms; easing: ease; }
            accessible-role: button;
            accessible-label: PlayerState.is-loading ? "正在加载" : (PlayerState.is-playing ? "暂停" : "播放");
            accessible-enabled: !PlayerState.is-loading;

            main-play-ta := TouchArea {
                mouse-cursor: PlayerState.is-loading ? wait : pointer;
                clicked => {
                    PlayerState.toggle-playback();
                }
            }

            if PlayerState.is-loading : PlaybackSpinner {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 26px;
                tint: root.btn-text;
                track-color: root.contrast-color;
            }

            if !PlayerState.is-loading : AppIcon {
                x: 20px;
                y: 20px;
                source: PlayerState.is-playing ? Icons.pause : Icons.play;
                icon-size: 32px;
                tint: root.btn-text;
            }
        }

        // 下一首
        Rectangle {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            opacity: next-ta.has-hover ? 1.0 : 0.8;

            next-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.next();
                }
            }

            AppIcon {
                source: Icons.next;
                icon-size: 24px;
                tint: root.text-color;
            }
        }
    }
}
