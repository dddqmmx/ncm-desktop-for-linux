import { PlayerState } from "../state/player.slint";
import { PlayerViewState } from "../state/player_view.slint";
import { FullscreenVisualPanel } from "fullscreen_visual.slint";
import { CommentPanelView } from "comment_panel.slint";
import { LyricPanelView } from "lyric_panel.slint";
import { Icons } from "../icons.slint";

import { AppIcon } from "common.slint";

component FullscreenBackButton inherits Rectangle {
    in property <color> text-color;
    in property <color> contrast-color;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: back-ta.has-hover ? rgba(255, 255, 255, 0.24) : root.contrast-color;
    animate background { duration: 300ms; easing: ease; }

    back-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            PlayerViewState.is-fullscreen-volume-open = false;
            PlayerViewState.is-fullscreen = false;
        }
    }

    AppIcon {
        x: 10px;
        y: 10px;
        source: Icons.chevron-down;
        icon-size: 24px;
        tint: root.text-color;
    }
}

export component PlayerFullscreen inherits Rectangle {
    in property <bool> presented: true;
    width: 100%;
    height: 100%;

    property <color> text-color: PlayerViewState.fullscreen-is-dark ? #ffffff : #000000;
    property <color> contrast-color: PlayerViewState.fullscreen-is-dark ? rgba(255, 255, 255, 0.15) : rgba(0, 0, 0, 0.10);
    property <color> btn-bg: PlayerViewState.fullscreen-is-dark ? #ffffff : #000000;
    property <color> btn-text: PlayerViewState.fullscreen-is-dark ? #000000 : #ffffff;

    TouchArea {
        clicked => {
            PlayerViewState.is-fullscreen-volume-open = false;
        }
    }

    // 动态背景层 (.dynamic-background: transition background 1.5s ease)
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(135deg, PlayerViewState.fullscreen-bg-primary 0%, PlayerViewState.fullscreen-bg-secondary 100%);
        animate background { duration: 1500ms; easing: ease; }
    }

    // 暗角层 (.vignette)
    Rectangle {
        width: 100%;
        height: 100%;
        background: @radial-gradient(circle, transparent 0%, rgba(0, 0, 0, 0.22) 100%);
    }

    // 主内容容器 (.player-content: padding 40px 60px)
    if root.presented : player-content := VerticalLayout {
        padding-top: root.width <= 1000px ? 20px : root.width <= 1100px ? 30px : 40px;
        padding-bottom: root.width <= 1000px ? 20px : root.width <= 1100px ? 30px : 40px;
        padding-left: root.width <= 1000px ? 20px : root.width <= 1100px ? 30px : 60px;
        padding-right: root.width <= 1000px ? 20px : root.width <= 1100px ? 30px : 60px;
        spacing: 40px;

        // 顶部栏 (.top-bar)
        HorizontalLayout {
            height: 44px;
            alignment: space-between;

            // 返回按钮 (.back-btn: x=60, y=40, 44x44, border-radius 50%, transition all 0.3s)
            fullscreen-back-btn := FullscreenBackButton {
                text-color: root.text-color;
                contrast-color: root.contrast-color;
            }

            Rectangle { width: 1px; }
        }

        // 主双栏布局 (.main-layout: x=60, y=124, width=1315, height=836, gap=60px)
        fullscreen-main-layout := FlexboxLayout {
            vertical-stretch: 1;
            min-height: 0px;
            flex-direction: root.width <= 1000px ? column : row;
            alignment: stretch;
            cross-axis-alignment: stretch;
            flex-wrap: no-wrap;
            spacing: root.width <= 1000px ? 40px : root.width <= 1100px ? 30px : 60px;

            visual-panel := FullscreenVisualPanel {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                preferred-width: 0px;
                preferred-height: 0px;
                min-width: 0px;
                min-height: 0px;
                max-width: root.width;
                max-height: root.height;
                text-color: root.text-color;
                contrast-color: root.contrast-color;
                btn-bg: root.btn-bg;
                btn-text: root.btn-text;
                compact: root.width <= 1000px;
            }

            // 右侧：歌词面板 / 评论面板（x=747.5, y=124, width=627.5, height=836）
            right-panel := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                preferred-width: 0px;
                preferred-height: 0px;
                min-width: 0px;
                min-height: 0px;
                max-width: root.width;
                max-height: root.height;

                if PlayerViewState.is-comment-open && !PlayerState.current-song-is-local : CommentPanelView {
                    width: 100%;
                    height: 100%;
                    is-dark: PlayerViewState.fullscreen-is-dark;
                }

                if !PlayerViewState.is-comment-open && !PlayerState.current-song-is-local : LyricPanelView {
                    width: 100%;
                    height: 100%;
                    is-dark: PlayerViewState.fullscreen-is-dark;
                }

                if PlayerState.current-song-is-local : Rectangle {
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }
}
