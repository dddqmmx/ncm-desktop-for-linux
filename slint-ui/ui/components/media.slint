import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { AppState, RecommendPlaylistItem, DailySongItem, TrackItem } from "../state.slint";
import { AppIcon, RoundedCover, CoverRequest } from "common.slint";
import { VirtualRows } from "virtual_rows.slint";
import { SkeletonBlock } from "skeleton.slint";
import { PlaylistButton } from "../overlays/playlist_editor.slint";

// 对应 MediaCard.vue (200x250, border-radius 18px, hover translateY(-4px) 0.25s, play-btn translateY(6px -> 0) opacity(0 -> 1) 0.25s ease)
export component MediaCard inherits Rectangle {
    in property <RecommendPlaylistItem> item;
    in property <int> cover-size: 800;
    CoverRequest { cover-id: root.item.id; pixel-size: root.cover-size; missing: root.item.cover.width == 0; }
    in-out property <bool> force-hover: false;
    callback clicked();
    callback play-clicked();

    width: 200px;
    height: 250px;
    background: transparent;

    property <bool> is-hovered: card-ta.has-hover || play-btn-ta.has-hover || root.force-hover;
    property <length> card-offset-y: self.is-hovered ? -4px : 0px;
    property <length> btn-offset-y: self.is-hovered ? 0px : 6px;
    property <float> btn-opacity: self.is-hovered ? 1.0 : 0.0;

    animate card-offset-y { duration: 250ms; easing: ease; }
    animate btn-offset-y, btn-opacity { duration: 250ms; easing: ease; }

    card-surface := Rectangle {
        x: 0px;
        y: root.card-offset-y;
        width: 200px;
        height: 250px;
        border-radius: 18px;
        background: Theme.sys-bg-muted;
        drop-shadow-blur: root.is-hovered ? 40px : 24px;
        drop-shadow-offset-y: root.is-hovered ? 16px : 8px;
        drop-shadow-color: root.is-hovered ? Theme.sys-shadow-elevated : Theme.sys-shadow-soft;
        clip: true;

        card-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }

        Image {
            width: 100%;
            height: 100%;
            source: root.item.cover;
            image-fit: cover;
        }

        // 底部暗角遮罩 (.card-overlay)
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, rgba(0, 0, 0, 0.0) 0%, rgba(0, 0, 0, 0.08) 32%, rgba(0, 0, 0, 0.72) 100%);
        }

        // 卡片内容 (.card-content: padding 24px)
        VerticalLayout {
            padding: 24px;
            alignment: space-between;

            Rectangle { height: 1px; }

            Text {
                text: root.item.title;
                font-size: 24px;
                font-weight: 800;
                color: #ffffff;
                wrap: word-wrap;
            }

            Text {
                text: root.item.desc;
                font-size: 13px;
                font-weight: 500;
                color: rgba(255, 255, 255, 0.90);
                wrap: word-wrap;
            }
        }

        // 右下角悬浮播放按钮 (.play-btn-circle: bottom 20px, right 20px, 40x40, translateY(6px -> 0))
        play-btn-circle := Rectangle {
            x: parent.width - 20px - 40px;
            y: parent.height - 20px - 40px + root.btn-offset-y;
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: play-btn-ta.has-hover ? rgba(255, 255, 255, 0.36) : rgba(255, 255, 255, 0.25);
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.40);
            opacity: root.btn-opacity;

            play-btn-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.play-clicked(); }
            }

            AppIcon {
                x: 10px;
                y: 10px;
                source: Icons.play;
                icon-size: 20px;
                tint: #ffffff;
            }
        }
    }
}

// 对应 AlbumItem.vue (176x235.09, hover translateY(-4px) 0.3s ease, cover 176x176 radius 28px, img scale(1.06) 0.35s ease)
export component AlbumItem inherits Rectangle {
    in property <DailySongItem> item;
    in property <int> cover-size: 800;
    CoverRequest { cover-id: root.item.id; pixel-size: root.cover-size; missing: root.item.cover.width == 0; }
    in-out property <bool> force-hover: false;
    callback clicked();

    width: 176px;
    height: 235.09px;

    property <bool> is-hovered: item-ta.has-hover || root.force-hover;
    property <length> item-offset-y: self.is-hovered ? -4px : 0px;
    property <float> img-scale: self.is-hovered ? 1.06 : 1.0;

    animate item-offset-y { duration: 300ms; easing: ease; }
    animate img-scale { duration: 350ms; easing: ease; }

    item-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Rectangle {
        x: 0px;
        y: root.item-offset-y;
        width: 176px;
        height: 235.09px;

        // 176x176 封面 (.album-cover: border-radius 28px, margin-bottom 14px)
        album-cover := Rectangle {
            x: 0px;
            y: 0px;
            width: 176px;
            height: 176px;
            border-radius: 28px;
            background: @linear-gradient(145deg, Theme.sys-surface-strong 0%, Theme.theme-color-soft 100%);
            border-width: 1px;
            border-color: Theme.sys-border;
            drop-shadow-blur: root.is-hovered ? 32px : 22px;
            drop-shadow-offset-y: root.is-hovered ? 12px : 8px;
            drop-shadow-color: Theme.sys-shadow-soft;
            clip: true;

            album-cover-img := Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.width * root.img-scale;
                height: parent.height * root.img-scale;
                source: root.item.cover;
                image-fit: cover;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(180deg, rgba(16, 24, 40, 0.0) 42%, rgba(16, 24, 40, 0.16) 100%);
            }
        }

        // 文字信息 (.album-info: y = 176 + 14 = 190px, padding 0 6px)
        VerticalLayout {
            x: 6px;
            y: 190px;
            width: 164px;
            height: 45.09px;
            spacing: 6px;

            Text {
                text: root.item.title;
                font-size: 15px;
                font-weight: 700;
                color: Theme.sys-text;
                overflow: elide;
            }

            Text {
                text: root.item.artist;
                font-size: 13px;
                color: Theme.sys-text-secondary;
                overflow: elide;
            }
        }
    }
}

// 对应 SongList.vue 的单行与完整曲目表
component SongTrackRow inherits Rectangle {
    in property <TrackItem> track;
    in property <bool> is-local-variant: false;
    in property <bool> show-remove-from-playlist: false;

    property <bool> is-active: AppState.current-song-id == root.track.id;
    property <bool> is-hovered: row-ta.has-hover || fav-ta.has-hover || more-ta.has-hover || album-ta.has-hover;
    property <bool> show-album-col: AppState.window-width > 900px;

    height: 57.58px;
    border-radius: 10px;
    background: root.is-active
        ? Theme.sys-control-active
        : (root.is-hovered ? Theme.sys-control : transparent);
    animate background { duration: 200ms; easing: ease; }

    row-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            AppState.play-song(root.track.id, root.track.name, root.track.artist, root.track.cover, root.track.is-local, root.track.has-cover);
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 0px;

        // .col-index (40px)
        Rectangle {
            width: 40px;

            if !root.is-hovered : Text {
                text: root.track.index-str;
                font-size: 13px;
                color: Theme.sys-text-disabled;
                vertical-alignment: center;
            }

            if root.is-hovered : AppIcon {
                x: 0px;
                y: (parent.height - self.height) / 2;
                source: Icons.play;
                icon-size: 14px;
                tint: Theme.theme-color-strong;
            }
        }

        // .col-title (flex 3, gap 14px)
        HorizontalLayout {
            horizontal-stretch: 3;
            spacing: 14px;

            mini-cover := RoundedCover {
                cover-id: root.track.id;
                width: 40px;
                height: 40px;
                y: (parent.height - self.height) / 2;
                radius: 6px;
                source: root.track.cover;
                is-local-fallback: root.is-local-variant && !root.track.has-cover;
                fallback-icon-size: 20px;
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: root.track.name;
                    font-size: 14px;
                    font-weight: 500;
                    color: root.is-active ? Theme.theme-color-strong : Theme.sys-text;
                    overflow: elide;
                }

                Text {
                    text: root.track.artist;
                    font-size: 12px;
                    color: Theme.sys-text-tertiary;
                    overflow: elide;
                }
            }
        }

        // .col-album (flex 2, @media max-width 900px 隐藏)
        Rectangle {
            horizontal-stretch: root.show-album-col ? 2 : 0;
            width: root.show-album-col ? self.preferred-width : 0px;
            visible: root.show-album-col;

            album-ta := TouchArea {
                enabled: !root.is-local-variant && root.show-album-col;
                mouse-cursor: root.is-local-variant ? default : pointer;
                clicked => {
                    if (!root.is-local-variant) {
                        AppState.album-title = root.track.album;
                        AppState.album-cover = root.track.cover;
                        if AppState.runtime-enabled { AppState.runtime-action("song-album", root.track.id, ""); } else { AppState.current-route = "album"; }
                    }
                }
            }

            Text {
                width: 100%;
                height: 100%;
                text: root.track.album;
                font-size: 13px;
                color: (!root.is-local-variant && album-ta.has-hover) ? Theme.sys-text : Theme.sys-text-tertiary;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // .col-time (width 116px, justify-content flex-end, gap 10px)
        HorizontalLayout {
            width: 116px;
            alignment: end;
            spacing: 10px;

            Rectangle {
                width: root.is-local-variant ? 0px : 28px;
                height: 28px;
                visible: !root.is-local-variant;
                y: (parent.height - self.height) / 2;
                border-radius: 14px;
                background: fav-ta.has-hover ? Theme.sys-control-hover : transparent;
                opacity: (root.track.is-favorite || root.is-hovered) ? 1.0 : 0.0;
                animate opacity, background { duration: 200ms; easing: ease; }

                fav-ta := TouchArea {
                    enabled: !root.is-local-variant;
                    mouse-cursor: pointer;
                    clicked => {
                        if AppState.runtime-enabled { AppState.toggle-favorite(root.track.id); } else if (AppState.current-song-id == root.track.id) {
                            AppState.toggle-favorite(AppState.current-song-id);
                        }
                    }
                }

                AppIcon {
                    x: 6px;
                    y: 6px;
                    source: root.track.is-favorite ? Icons.heart-fill : Icons.heart;
                    icon-size: 16px;
                    tint: (root.track.is-favorite || fav-ta.has-hover) ? Theme.theme-color-strong : Theme.sys-text-disabled;
                }
            }

            Text {
                text: root.track.duration;
                font-size: 12px;
                color: Theme.sys-text-tertiary;
                vertical-alignment: center;
            }

            Rectangle {
                width: root.is-local-variant ? 30px : 28px;
                height: root.is-local-variant ? 30px : 28px;
                y: (parent.height - self.height) / 2;
                border-radius: 15px;
                background: more-ta.has-hover ? Theme.sys-control-hover : transparent;
                opacity: (root.is-hovered || AppState.open-menu-song-id == root.track.id) ? 1.0 : 0.0;
                animate opacity, background { duration: 200ms; easing: ease; }

                more-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.is-local-variant) {
                            AppState.is-dialog-open = true;
                        } else {
                            if (AppState.open-menu-song-id == root.track.id) {
                                AppState.open-menu-song-id = -1;
                            } else {
                                AppState.open-menu-song-id = root.track.id;
                                AppState.open-menu-song-name = root.track.name;
                                AppState.open-menu-show-remove = root.show-remove-from-playlist;
                                AppState.open-menu-submenu = false;
                            }
                        }
                    }
                }

                AppIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.is-local-variant ? Icons.close-fill : Icons.more-dots;
                    icon-size: 16px;
                    tint: more-ta.has-hover ? Theme.sys-text : Theme.sys-text-disabled;
                }
            }
        }
    }
}

export component SongList inherits VerticalLayout {
    in property <[TrackItem]> songs: [];
    in property <bool> loading: false;
    in property <string> load-error;
    callback retry();
    in property <length> viewport-top;
    in property <length> viewport-height;
    in property <bool> is-local-variant: false;
    in property <bool> show-remove-from-playlist: false;

    property <bool> show-album-col: AppState.window-width > 900px;
    spacing: 0px;

    // 吸顶表头 (.list-header-content: height 49.8px, padding 14px 16px, border-bottom 1px)
    list-header := Rectangle {
        height: 49.8px;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;

            Text {
                width: 40px;
                text: "#";
                font-size: 11px;
                font-weight: 700;
                color: Theme.sys-text-tertiary;
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 3;
                text: "标题";
                font-size: 11px;
                font-weight: 700;
                color: Theme.sys-text-tertiary;
                vertical-alignment: center;
            }

            if root.show-album-col : Text {
                horizontal-stretch: 2;
                text: root.is-local-variant ? "文件" : "专辑";
                font-size: 11px;
                font-weight: 700;
                color: Theme.sys-text-tertiary;
                vertical-alignment: center;
            }

            HorizontalLayout {
                width: 116px;
                alignment: end;

                AppIcon {
                    y: (parent.height - self.height) / 2;
                    source: Icons.clock;
                    icon-size: 14px;
                    tint: Theme.sys-text-tertiary;
                }
            }
        }

        Rectangle {
            y: parent.height - 1px;
            width: 100%;
            height: 1px;
            background: Theme.sys-border;
        }
    }

    if root.loading : loading-rows := VerticalLayout {
        spacing: 0px;
        accessible-role: progress-indicator;
        accessible-label: "正在加载歌曲";
        for index in Math.max(6, Math.ceil(root.viewport-height / 61.58px)) : Rectangle {
            height: 61.58px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Rectangle {
                    width: 40px;
                    SkeletonBlock { x: 0px; width: 14px; height: 12px; y: (parent.height - self.height) / 2; }
                }
                HorizontalLayout {
                    horizontal-stretch: 3;
                    spacing: 14px;
                    SkeletonBlock { width: 40px; height: 40px; y: (parent.height - self.height) / 2; }
                    Rectangle {
                        horizontal-stretch: 1;
                        SkeletonBlock { x: 0px; y: 14px; width: parent.width * 0.7; height: 14px; }
                        SkeletonBlock { x: 0px; y: 36px; width: parent.width * 0.4; height: 10px; }
                    }
                }
                if root.show-album-col : Rectangle {
                    horizontal-stretch: 2;
                    SkeletonBlock { x: 0px; width: parent.width * 0.6; height: 12px; y: (parent.height - self.height) / 2; }
                }
                Rectangle {
                    width: 116px;
                    SkeletonBlock { x: parent.width - 40px; width: 40px; height: 12px; y: (parent.height - self.height) / 2; }
                }
            }
        }
    }

    rows := VirtualRows {
        row-count: root.loading || root.load-error != "" ? 0 : root.songs.length;
        row-height: 61.58px;
        viewport-top: root.viewport-top - self.y;
        viewport-height: root.viewport-height;
        for offset in rows.slot-count : SongTrackRow {
            property <int> target-index: rows.row-index(offset);
            property <int> item-index: -1;
            init => { self.item-index = self.target-index; }
            changed target-index => { self.item-index = self.target-index; }
            visible: item-index < rows.end-row;
            y: (item-index) * rows.row-height + 2px;
            width: parent.width;
            track: root.songs[item-index];
            is-local-variant: root.is-local-variant;
            show-remove-from-playlist: root.show-remove-from-playlist;
        }
    }

    if !root.loading && root.load-error != "" : load-error-panel := Rectangle {
        height: 132px;
        Text {
            x: 16px; y: 16px; width: parent.width - 32px; height: 48px;
            text: "歌单加载失败：" + root.load-error;
            font-size: 14px;
            color: Theme.sys-text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
        retry-button := PlaylistButton {
            x: (parent.width - self.width) / 2; y: 76px;
            width: 96px; height: 36px; border-radius: 18px;
            label: "重新加载";
            filled: true;
            clicked => { root.retry(); }
        }
    }

    if !root.loading && root.load-error == "" && root.songs.length == 0 : empty-state := Rectangle {
        height: 100px;
        Text {
            text: "暂无歌曲";
            font-size: 14px;
            color: Theme.sys-text-tertiary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
