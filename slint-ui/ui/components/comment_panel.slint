import { PlayerViewState } from "../state/player_view.slint";
import { CommentPalette, CommentRow } from "comment_item.slint";

export component CommentPanelView inherits Rectangle {
    in property <bool> is-dark: true;
    property <CommentPalette> palette: {
        text: root.is-dark ? rgba(255, 255, 255, 0.92) : rgba(0, 0, 0, 0.90),
        secondary: root.is-dark ? rgba(255, 255, 255, 0.62) : rgba(0, 0, 0, 0.60),
        tertiary: root.is-dark ? rgba(255, 255, 255, 0.42) : rgba(0, 0, 0, 0.40),
        surface: root.is-dark ? rgba(255, 255, 255, 0.07) : rgba(0, 0, 0, 0.045),
        border: root.is-dark ? rgba(255, 255, 255, 0.14) : rgba(0, 0, 0, 0.10),
        divider: root.is-dark ? rgba(255, 255, 255, 0.08) : rgba(0, 0, 0, 0.06),
    };
    clip: true;

    comment-scroll := Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: cmt-col.preferred-height;
        cmt-col := VerticalLayout {
            width: 100%;
            padding-top: 4px;
            padding-right: 16px;
            padding-bottom: 20px;
            padding-left: 2px;
            spacing: 0px;
            for item in PlayerViewState.comments : CommentRow { item: item; palette: root.palette; }
            footer := Text {
                height: 48px;
                text: "没有更多评论了";
                font-size: 12px;
                color: root.palette.tertiary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
