import { PlayerState } from "../state/player.slint";
import { FlowText } from "typography.slint";

export component FullscreenProgress inherits HorizontalLayout {
    in property <color> text-color;
    in property <color> contrast-color;
    spacing: 15px;
    cross-axis-alignment: center;
    FlowText {
        min-width: 72px;
        text: PlayerState.current-time-str;
        font-size: 12px;
        font-weight: 600;
        color: root.text-color;
        opacity: 0.6;
        horizontal-alignment: center;
    }
    progress-input := Rectangle {
        horizontal-stretch: 1;
        min-width: 0px;
        height: 20px;
        fullscreen-progress-bar := Rectangle {
            y: (parent.height - self.height) / 2;
            width: 100%;
            height: 6px;
            border-radius: 3px;
            background: root.contrast-color;
            clip: true;
            buffered-fill := Rectangle {
                x: 0px;
                width: parent.width * Math.clamp(PlayerState.buffered-percent / 100, 0, 1);
                height: 100%;
                border-radius: 3px;
                background: root.contrast-color;
                animate width { duration: 250ms; easing: ease; }
            }
            played-fill := Rectangle {
                x: 0px;
                width: parent.width * Math.clamp(PlayerState.progress-percent / 100, 0, 1);
                height: 100%;
                border-radius: 3px;
                background: root.text-color;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left)
                    || (event.kind == PointerEventKind.move && self.pressed) {
                    PlayerState.seek-to(Math.clamp(self.mouse-x / Math.max(1px, self.width), 0, 1) * 100);
                }
            }
        }
    }
    FlowText {
        min-width: 72px;
        text: PlayerState.duration-time-str;
        font-size: 12px;
        font-weight: 600;
        color: root.text-color;
        opacity: 0.6;
        horizontal-alignment: center;
    }
}
