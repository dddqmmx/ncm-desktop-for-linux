import { FlowText } from "typography.slint";
import { Icons } from "../icons.slint";
import { CommentItem } from "../models.slint";
import { AppIcon, RoundedCover } from "common.slint";

export struct CommentPalette {
    text: color,
    secondary: color,
    tertiary: color,
    surface: color,
    border: color,
    divider: color,
}

component CommentSectionHeading inherits Rectangle {
    in property <string> label;
    in property <color> text-color;
    height: label.height + 12px;
    label := FlowText {
        x: 2px;
        y: 6px;
        text: root.label;
        font-size: 12px;
        font-weight: 700;
        color: root.text-color;
    }
}

component CommentMetadata inherits HorizontalLayout {
    in property <CommentItem> item;
    in property <CommentPalette> palette;
    spacing: 8px;
    alignment: space-between;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text {
            text: root.item.nickname;
            font-size: 13px;
            font-weight: 600;
            color: root.palette.secondary;
            vertical-alignment: center;
        }
        if root.item.is-vip : Rectangle {
            width: 28px;
            height: 16px;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.palette.border;
            Text {
                text: "VIP";
                font-size: 9px;
                font-weight: 800;
                color: root.palette.tertiary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    Text {
        text: root.item.time;
        font-size: 11px;
        color: root.palette.tertiary;
        vertical-alignment: center;
    }
}

component CommentReply inherits Rectangle {
    in property <CommentItem> item;
    in property <CommentPalette> palette;
    border-radius: 10px;
    background: root.palette.surface;
    height: reply-text.height + 16px;
    reply-text := FlowText {
        line-height: 1.5;
        x: 10px;
        y: 8px;
        width: parent.width - 20px;
        text: "@" + root.item.reply-nickname + "：" + root.item.reply-content;
        font-size: 13px;
        color: root.palette.secondary;
        wrap: word-wrap;
    }
}

export component CommentRow inherits VerticalLayout {
    in property <CommentItem> item;
    in property <CommentPalette> palette;
    spacing: 0px;

    if root.item.is-hot-header : Rectangle { height: 6px; }
    if root.item.is-hot-header : comment-section-hot := CommentSectionHeading {
        label: "热门评论";
        text-color: root.palette.tertiary;
    }
    if root.item.is-recent-header : Rectangle { height: 6px; }
    if root.item.is-recent-header : comment-section-recent := CommentSectionHeading {
        label: "最新评论";
        text-color: root.palette.tertiary;
    }
    HorizontalLayout {
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 12px;
        avatar := RoundedCover {
            width: 36px;
            height: 36px;
            radius: 18px;
            source: root.item.avatar;
            cover-id: root.item.id;
        }
        body := VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            metadata := CommentMetadata { item: root.item; palette: root.palette; }
            content := Text {
                text: root.item.content;
                font-size: 14px;
                color: root.palette.text;
                wrap: word-wrap;
            }
            if root.item.has-reply : reply := CommentReply { item: root.item; palette: root.palette; }
            HorizontalLayout {
                padding-top: 2px;
                spacing: 5px;
                alignment: start;
                AppIcon { source: Icons.like; icon-size: 13px; tint: root.palette.tertiary; opacity: 0.7; }
                Text { text: root.item.liked; font-size: 11px; color: root.palette.tertiary; vertical-alignment: center; }
            }
        }
    }
    Rectangle { height: 1px; background: root.palette.divider; }
}
