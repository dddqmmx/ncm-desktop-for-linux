import { Icons } from "icons.slint";

export struct NavPlaylistItem {
    id: int,
    name: string,
    track-count: int,
    play-count: string,
    cover: image,
    already-added: bool,
}

export struct RecommendPlaylistItem {
    id: int,
    title: string,
    desc: string,
    cover: image,
}

export struct DailySongItem {
    id: int,
    title: string,
    artist: string,
    cover: image,
}

export struct HomeChartItem {
    id: int,
    title: string,
    update: string,
    cover: image,
    tracks: [string],
}

export struct TrackItem {
    id: int,
    index-str: string,
    name: string,
    artist: string,
    album: string,
    duration: string,
    cover: image,
    is-favorite: bool,
    is-local: bool,
    has-cover: bool,
}

export struct CategoryItem {
    name: string,
    color-type: string,
}

export struct QueueSongItem {
    id: int,
    index: int,
    name: string,
    artist: string,
    cover: image,
    is-local: bool,
    has-cover: bool,
}

export struct LyricLineItem {
    time-str: string,
    text: string,
    pronunciation: string,
    translation: string,
    // Measured once per layout; scrolling only reads adjacent line centers.
    layout-center: length,
}

export struct CommentItem {
    id: int,
    nickname: string,
    avatar: image,
    is-vip: bool,
    time: string,
    content: string,
    has-reply: bool,
    reply-nickname: string,
    reply-content: string,
    liked: string,
    is-hot-header: bool,
    is-recent-header: bool,
}

export struct ArtistReleaseItem {
    id: int,
    kind: string,
    title: string,
    year: string,
    cover: image,
}

export struct ArtistSongItem {
    id: int,
    index-str: string,
    title: string,
    album: string,
    duration: string,
    cover: image,
    badge: string, // "" | "hot" | "rec"
}

export struct DownloadQualityItem { quality: string, label: string, available: bool, reason: string }

export struct OutputDeviceItem { id: string, name: string, current: bool }
export struct SettingChoice { value: string, label: string }

export struct AuxButtonItem {
    id: string, // "favorite" | "comment" | "playMode" | "volume"
    visible: bool,
}

export global AppState {
    callback request-cover(int, int);
    in-out property <[DownloadQualityItem]> download-qualities;
    in-out property <int> download-song-id: -1;
    in-out property <string> download-song-name;
    in-out property <bool> is-download-open: false;
    in-out property <[OutputDeviceItem]> output-devices: [
        { id: "hw:demo", name: "USB Hi-Fi DAC Audio (当前)", current: true },
        { id: "", name: "系统默认输出", current: false },
    ];
    in-out property <int> setting-output-device-index: 0;
    in-out property <[string]> setting-cache-details: ["642.8 MB", "38 首", "14.2 MB", "64 个", "48.6 MB", "126 个", "820.0 KB", "92 首"];
    changed setting-cache-details => { self.settings-changed("setting-cache-details"); }
    changed output-devices => { self.settings-changed("output-devices"); }
    changed setting-output-device-index => { self.settings-changed("setting-output-device-index"); }
    changed runtime-message => { self.settings-changed("runtime-message"); }
    in-out property <bool> runtime-enabled: false;
    in-out property <string> runtime-message;
    in-out property <bool> login-busy: false;
    in-out property <bool> login-captcha-busy: false;
    in-out property <int> login-captcha-seconds: 0;
    in-out property <image> login-qr-image;
    in-out property <bool> login-qr-ready: false;
    in-out property <string> login-qr-message;
    callback prepare-login-flip();
    in-out property <image> login-front-frame;
    in-out property <image> login-back-frame;
    in-out property <[image]> login-front-strips;
    in-out property <[image]> login-back-strips;
    in-out property <bool> login-flip-ready: false;
    in-out property <float> login-render-scale: 1;
    callback runtime-action(string, int, string);
    callback seek-requested(float);
    public function toggle-playback() {
        if self.is-loading { return; }
        if self.runtime-enabled { self.runtime-action("toggle", -1, ""); }
        else { self.is-playing = !self.is-playing; }
    }
    public function toggle-favorite(id: int) {
        if self.runtime-enabled { self.runtime-action("favorite", id, ""); }
        else if self.current-song-id == id { self.current-song-favorite = !self.current-song-favorite; }
    }
    public function seek-to(value: float) {
        if self.runtime-enabled { self.seek-requested(value); }
        else { self.progress-percent = value; }
    }
    public function step-song(delta: int) {
        if self.runtime-enabled { self.runtime-action("step", delta, ""); }
        else { self.progress-percent = delta > 0 ? 12.0 : 0.0; self.current-time-str = delta > 0 ? "0:29" : "0:00"; }
    }
    changed is-comment-open => { if self.runtime-enabled && self.is-comment-open { self.runtime-action("comments", self.current-song-id, ""); } }
    changed login-tab => { self.login-error = ""; }
    changed login-mode => {
        self.login-error = "";
        if self.is-login-open { self.prepare-login-flip(); }
        if self.runtime-enabled && self.is-login-open { self.runtime-action("login-mode", -1, self.login-mode); }
    }
    changed is-login-open => {
        if self.is-login-open { self.reset-login(); }
        else {
            if self.runtime-enabled { self.runtime-action("close-login", -1, ""); }
            self.login-password = "";
            self.login-code = "";
            self.login-captcha-seconds = 0;
        }
    }
    public function reset-login() {
        self.login-mode = "form";
        self.login-tab = "password";
        self.login-remember = false;
        self.login-country-code = "86";
        self.login-sms-country-code = "86";
        self.login-phone = "";
        self.login-sms-phone = "";
        self.login-password = "";
        self.login-code = "";
        self.login-error = "";
        self.login-busy = false;
        self.login-captcha-busy = false;
        self.login-captcha-seconds = 0;
        self.login-qr-ready = false;
        self.login-qr-message = "";
        self.login-flip-ready = false;
    }
    public function submit-login() {
        if self.login-busy { return; }
        if self.runtime-enabled { self.runtime-action("login", -1, ""); }
        else { self.is-logged-in = true; self.is-login-open = false; }
    }

    // 窗口实时尺寸（用于与 CSS @media 媒体查询断点保持 100% 一致）
    in-out property <length> window-width: 1435px;
    in-out property <length> window-height: 1000px;

    // 路由: "home" | "search" | "favorites" | "local-music" | "playlist" | "album" | "artist"
    in-out property <string> current-route: "home";
    in-out property <int> active-playlist-id: 101;

    // 用户状态
    in-out property <bool> is-logged-in: true;
    in-out property <string> user-nickname: "云村漫游者";
    in-out property <image> user-avatar: Icons.avatar-user;

    // 浮层与弹窗状态
    in-out property <bool> is-fullscreen: false;
    in-out property <bool> is-playlist-open: false;
    in-out property <bool> is-volume-popup-open: false;
    in-out property <bool> is-fullscreen-volume-open: false;
    in-out property <bool> is-comment-open: false;
    in-out property <bool> is-add-to-playlist-open: false;
    in-out property <string> add-to-playlist-song-name: "Neon Nocturne";
    in-out property <bool> is-login-open: false;
    in-out property <string> login-mode: "form"; // "form" | "qr"
    in-out property <string> login-tab: "password"; // "password" | "phone"
    in-out property <bool> login-remember: false;
    in-out property <string> login-country-code: "86";
    in-out property <string> login-phone: "";
    in-out property <string> login-sms-country-code: "86";
    in-out property <string> login-sms-phone: "";
    in-out property <string> login-password: "";
    in-out property <string> login-code: "";
    in-out property <string> login-error: "";
    callback open-settings-window();
    callback settings-changed(string);
    in-out property <string> settings-tab: "general"; // "general" | "audio" | "appearance" | "library" | "cache" | "shortcuts" | "debug" | "about"

    // AppDialog 弹窗状态
    in-out property <bool> is-dialog-open: false;
    in-out property <string> dialog-title: "清空本地音乐";
    in-out property <string> dialog-message: "将所有歌曲移出应用曲库，但不会删除磁盘上的音乐文件。";
    in-out property <string> dialog-mode: "confirm-cancel";
    in-out property <string> dialog-confirm-text: "清空";
    in-out property <string> dialog-cancel-text: "取消";

    // 行内右键/更多菜单状态
    in-out property <int> open-menu-song-id: -1;
    in-out property <string> open-menu-song-name: "";
    in-out property <bool> open-menu-show-remove: false;
    in-out property <bool> open-menu-submenu: false;

    // 播放器状态
    in-out property <int> current-song-id: 1;
    in-out property <string> current-song-title: "Midnight City Lights";
    in-out property <string> current-song-artist: "M83 / 落日飞车";
    in-out property <image> current-song-cover: Icons.cover-indigo;
    in-out property <bool> current-song-is-local: false;
    in-out property <bool> current-song-has-cover: true;
    in-out property <bool> current-song-favorite: true;
    in-out property <bool> is-playing: true;
    in-out property <bool> is-loading: false;
    in-out property <string> play-mode: "loop"; // "loop" | "single" | "random"
    in-out property <float> progress-percent: 38.0;
    in-out property <float> buffered-percent: 68.0;
    in-out property <string> current-time-str: "1:32";
    in-out property <string> duration-time-str: "4:03";
    in-out property <float> volume-percent: 76.0;
    in-out property <bool> can-adjust-volume: true;
    in-out property <bool> session-volume-locked: false;

    // 全屏播放器状态
    in-out property <bool> fullscreen-is-dark: true;
    in-out property <color> fullscreen-bg-primary: #3b3e98;
    in-out property <color> fullscreen-bg-secondary: #191d3a;
    in-out property <bool> show-pronunciation: true;
    in-out property <bool> show-translation: true;
    in-out property <int> active-lyric-index: 3;
    // A seek/song change requests immediate recentering, unlike normal playback.
    in-out property <int> lyric-position-reset: 0;
    in-out property <bool> show-lyric-seek-indicator: false;
    in-out property <int> centered-lyric-index: 4;
    in-out property <string> centered-lyric-time: "1:48";

    // 首页状态
    in-out property <bool> home-playlists-loading: false;
    in-out property <bool> home-songs-loading: false;

    // 搜索页状态
    in-out property <string> search-query: "";
    in-out property <bool> search-is-floating: false;
    in-out property <bool> search-show-results: false;
    in-out property <int> search-result-count: 42;

    // 详情页状态 (Playlist / Album / Favorites / LocalMusic)
    in-out property <string> detail-search-query: "";
    in-out property <bool> playlist-loading: false;
    in-out property <bool> playlist-metadata-loading: false;
    in-out property <string> playlist-load-error;
    in-out property <string> playlist-title: "深夜编码 · 赛博合成器浪潮";
    in-out property <bool> playlist-owned: true;
    in-out property <int> playlist-special-type: 0;
    out property <bool> playlist-can-manage: is-logged-in && playlist-owned && playlist-special-type == 0 && !playlist-loading && playlist-load-error == "";
    in-out property <bool> playlist-is-private: false;
    in-out property <int> playlist-track-count: 28;
    in-out property <[TrackItem]> playlist-tracks: detail-tracks;
    in-out property <string> playlist-editor-mode: ""; // "" | "create" | "edit"
    in-out property <string> playlist-editor-name;
    in-out property <string> playlist-editor-description;
    in-out property <bool> playlist-editor-private: false;
    in-out property <bool> playlist-editor-can-submit: false;
    in-out property <int> playlist-editor-name-length;
    in-out property <int> playlist-editor-description-length;
    in-out property <string> playlist-editor-error;
    in-out property <int> playlist-delete-id: -1;
    in-out property <bool> is-playlist-actions-open: false;
    in-out property <length> playlist-actions-x;
    in-out property <length> playlist-actions-y;
    in-out property <int> playlist-restore-focus: 0;
    callback open-create-playlist();
    callback open-edit-playlist();
    callback close-playlist-editor();
    callback playlist-input-changed();
    callback submit-playlist();
    callback open-playlist(int) -> bool;
    callback request-delete-playlist();
    callback confirm-playlist-delete();

    changed is-logged-in => {
        if !self.is-logged-in {
            self.is-playlist-actions-open = false;
            self.playlist-editor-mode = "";
            self.playlist-editor-can-submit = false;
            if self.playlist-delete-id >= 0 { self.is-dialog-open = false; }
            self.playlist-delete-id = -1;
        }
    }
    changed is-dialog-open => {
        if !self.is-dialog-open { self.playlist-delete-id = -1; }
    }
    changed current-route => { self.is-playlist-actions-open = false; if self.runtime-enabled { self.runtime-action("route", -1, self.current-route); } }
    changed playlist-can-manage => {
        if !self.playlist-can-manage {
            self.is-playlist-actions-open = false;
            if self.playlist-editor-mode == "edit" { self.playlist-editor-mode = ""; }
        }
    }
    in-out property <string> playlist-creator: "云村漫游者";
    in-out property <image> playlist-creator-avatar: Icons.avatar-user;
    in-out property <image> playlist-cover: Icons.cover-indigo;
    in-out property <string> playlist-description: "精选 Synthwave、Dream Pop 与电子器乐，伴你在霓虹夜色与终端微光中保持专注。";
    in-out property <string> playlist-subscribed-count: "12.8万";
    in-out property <[string]> playlist-meta: ["2026-05-18 创建", "28 首歌曲", "36.4万 次播放"];

    in-out property <string> album-title: "Hurry Up, We're Dreaming";
    in-out property <string> album-artist: "M83";
    in-out property <image> album-cover: Icons.cover-cyan;
    in-out property <string> album-description: "法国电子乐团 M83 的第六张录音室双碟专辑，融合宏大的合成器音墙与梦幻流行叙事。";
    in-out property <[string]> album-meta: ["2011-10-18 发行", "22 首歌曲", "Naive Records"];

    in-out property <string> favorite-description: "通过网易云账号同步的喜欢歌曲。";
    in-out property <image> favorite-cover: Icons.cover-rose;

    in-out property <string> local-description: "保存在此设备上的音乐，导入记录会保留在本地曲库中。";

    // 歌手页状态
    in-out property <string> artist-name: "M83";
    in-out property <image> artist-avatar: Icons.cover-indigo;
    in-out property <[string]> artist-pills: ["8 张专辑", "12 张 EP / 单曲", "16 支 MV"];
    in-out property <string> artist-summary: "法国电子与梦幻流行乐团，由 Anthony Gonzalez 于 1999 年在昂蒂布创立，以宏大的合成器音墙与电影感编曲闻名。";

    // 设置页状态
    in-out property <bool> setting-auto-launch: false;
    in-out property <bool> setting-tray-minimize: true;
    in-out property <string> setting-renderer: "vulkan";
    in-out property <string> startup-renderer: "vulkan";
    out property <[SettingChoice]> renderer-options: [
        { value: "vulkan", label: "Vulkan（默认）" },
        { value: "opengl", label: "OpenGL" },
        { value: "software", label: "软件渲染（关闭 GPU 加速）" },
    ];
    out property <int> setting-renderer-index:
        self.setting-renderer == "opengl" ? 1 : self.setting-renderer == "software" ? 2 : 0;
    out property <bool> renderer-restart-required: self.setting-renderer != self.startup-renderer;
    in-out property <string> setting-sound-quality: "lossless";
    out property <[SettingChoice]> sound-quality-options: [
        { value: "standard", label: "标准 (128kbps)" },
        { value: "exhigh", label: "极高 (320kbps)" },
        { value: "lossless", label: "无损 (最高48khz, 16bit)" },
        { value: "hires", label: "Hi-Res (最高192khz, 24bit)" },
        { value: "jyeffect", label: "高清臻音 (96khz, 24bit)" },
        { value: "sky", label: "沉浸环绕声 (最高5.1声道)" },
        { value: "jymaster", label: "超清母带 (192khz, 24bit)" },
    ];
    out property <int> setting-sound-quality-index:
        self.setting-sound-quality == "standard" ? 0 :
        self.setting-sound-quality == "exhigh" ? 1 :
        self.setting-sound-quality == "lossless" ? 2 :
        self.setting-sound-quality == "hires" ? 3 :
        self.setting-sound-quality == "jyeffect" ? 4 :
        self.setting-sound-quality == "sky" ? 5 :
        self.setting-sound-quality == "jymaster" ? 6 : -1;
    out property <string> setting-sound-quality-label: self.setting-sound-quality-index >= 0
        ? self.sound-quality-options[self.setting-sound-quality-index].label : "请选择音质";
    in-out property <string> setting-audio-engine: "native"; // "native" | "webapi" | "auto"
    in-out property <bool> setting-software-volume: true;
    in-out property <string> setting-output-device-label: "USB Hi-Fi DAC Audio (当前)";
    in-out property <bool> setting-supports-exclusive: true;
    in-out property <bool> setting-exclusive-mode: true;
    in-out property <bool> setting-strict-bitperfect: false;
    in-out property <bool> setting-acrylic: true;
    in-out property <string> setting-accent-hex: "#6366f1";
    in-out property <bool> setting-lyric-debug: false;
    in-out property <float> setting-cache-usage-percent: 34.5;
    in-out property <string> setting-cache-usage-text: "706.4 MB / 2.00 GB";
    in-out property <float> setting-cache-limit-mb: 2048;
    in-out property <float> setting-cache-ahead-mb: 32;
    in-out property <[string]> setting-lib-paths: [
        "/home/example/Music/FLAC-Library",
        "/mnt/media/NeteaseCloudMusic"
    ];

    // 全屏走带两侧辅助按钮配置
    in-out property <[AuxButtonItem]> fullscreen-aux-left: [
        { id: "favorite", visible: true },
        { id: "comment", visible: true },
    ];
    in-out property <[AuxButtonItem]> fullscreen-aux-right: [
        { id: "playMode", visible: true },
        { id: "volume", visible: true },
    ];

    // Each top-level window has its own globals. Rust mirrors preferences and
    // shares models; navigation, dialog state and window dimensions stay local.
    changed setting-auto-launch => { self.settings-changed("setting-auto-launch"); }
    changed setting-tray-minimize => { self.settings-changed("setting-tray-minimize"); }
    changed setting-renderer => { self.settings-changed("setting-renderer"); }
    changed startup-renderer => { self.settings-changed("startup-renderer"); }
    changed setting-sound-quality => { self.settings-changed("setting-sound-quality"); }
    changed setting-audio-engine => { self.settings-changed("setting-audio-engine"); }
    changed setting-software-volume => { self.settings-changed("setting-software-volume"); }
    changed setting-output-device-label => { self.settings-changed("setting-output-device-label"); }
    changed setting-supports-exclusive => { self.settings-changed("setting-supports-exclusive"); }
    changed setting-exclusive-mode => { self.settings-changed("setting-exclusive-mode"); }
    changed setting-strict-bitperfect => { self.settings-changed("setting-strict-bitperfect"); }
    changed setting-acrylic => { self.settings-changed("setting-acrylic"); }
    changed setting-accent-hex => { self.settings-changed("setting-accent-hex"); }
    changed setting-lyric-debug => { self.settings-changed("setting-lyric-debug"); }
    changed setting-cache-usage-percent => { self.settings-changed("setting-cache-usage-percent"); }
    changed setting-cache-usage-text => { self.settings-changed("setting-cache-usage-text"); }
    changed setting-cache-limit-mb => { self.settings-changed("setting-cache-limit-mb"); }
    changed setting-cache-ahead-mb => { self.settings-changed("setting-cache-ahead-mb"); }
    changed setting-lib-paths => { self.settings-changed("setting-lib-paths"); }
    changed fullscreen-aux-left => { self.settings-changed("fullscreen-aux-left"); }
    changed fullscreen-aux-right => { self.settings-changed("fullscreen-aux-right"); }
    changed volume-percent => { self.settings-changed("volume-percent"); }
    changed can-adjust-volume => { self.settings-changed("can-adjust-volume"); }
    changed session-volume-locked => { self.settings-changed("session-volume-locked"); }

    // 侧边栏创建的歌单
    in-out property <[NavPlaylistItem]> created-playlists: [
        { id: 101, name: "深夜编码 · 赛博合成器浪潮", track-count: 28, play-count: "36.4万", cover: Icons.cover-indigo, already-added: true },
        { id: 102, name: "冬日暖阳 · 独立民谣与原声", track-count: 45, play-count: "12.1万", cover: Icons.cover-sunset, already-added: false },
        { id: 103, name: "Tokyo City Pop 1984", track-count: 32, play-count: "89.2万", cover: Icons.cover-rose, already-added: false },
        { id: 104, name: "Post-Rock 器乐后摇精选", track-count: 19, play-count: "5.4万", cover: Icons.cover-cyan, already-added: false },
        { id: 105, name: "雨夜爵士咖啡馆 Lo-Fi", track-count: 64, play-count: "23.0万", cover: Icons.cover-mint, already-added: false },
    ];

    // 首页推荐歌单
    in-out property <[RecommendPlaylistItem]> recommend-playlists: [
        { id: 101, title: "深夜编码 · 赛博合成器浪潮", desc: "根据你常听的电子与器乐推荐", cover: Icons.cover-indigo },
        { id: 102, title: "微风与海岸线：夏日独立流行", desc: "每日私人甄选歌单", cover: Icons.cover-cyan },
        { id: 103, title: "落日大道 1986：复古驱动", desc: "重返黄金年代模拟合成器之声", cover: Icons.cover-sunset },
        { id: 104, title: "柔光镜下的梦幻盯鞋与梦泡", desc: "Shoegaze / Dream Pop 精选", cover: Icons.cover-rose },
        { id: 105, title: "森林呼吸：北欧氛围与新古典", desc: "安静阅读与深度工作背景音乐", cover: Icons.cover-mint },
        { id: 106, title: "静谧星轨：午夜极简电子", desc: "深夜独处时光专属频率", cover: Icons.cover-night },
    ];

    // Homepage discovery uses public endpoints independent of recommendations.
    in-out property <[DailySongItem]> home-new-albums;
    in-out property <[HomeChartItem]> home-charts;
    in-out property <bool> home-albums-loaded: false;
