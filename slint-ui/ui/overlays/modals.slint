import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { AppState, NavPlaylistItem } from "../state.slint";
import { AppIcon, RoundedCover } from "../components/common.slint";
import { VirtualRows } from "../components/virtual_rows.slint";

// 对应 SongContextMenu.vue (.song-context-menu: width 220px, border-radius 14px, padding 6px, border 1px)
export component SongContextMenuOverlay inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    TouchArea {
        clicked => {
            AppState.open-menu-song-id = -1;
        }
    }

    context-menu-card := Rectangle {
        width: 220px;
        height: 96.59px + (AppState.open-menu-submenu ? (AppState.runtime-enabled ? Math.min(AppState.created-playlists.length * 40px + 4px, 244px) : 204px) : 0px) + (AppState.runtime-enabled ? 36.8px : 0px);
        x: 1149px;
        y: 463.08px;
        border-radius: 14px;
        background: Theme.glass-fill-strong;
        border-width: 1px;
        border-color: Theme.glass-border;
        drop-shadow-blur: 36px;
        drop-shadow-offset-y: 14px;
        drop-shadow-color: Theme.glass-shadow-elevated;

        TouchArea {}

        // 1px border + 6px padding -> x=+7px, y=+7px, width=206px
        Rectangle {
            x: 7px;
            y: 7px;
            width: 206px;
            height: parent.height - 14px;

            if !AppState.is-logged-in : Rectangle {
                height: 40px;
                Text {
                    text: "请先登录";
                    font-size: 13px;
                    color: Theme.sys-text-tertiary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if AppState.is-logged-in : VerticalLayout {
                spacing: 0px;

                if AppState.runtime-enabled : Rectangle {
                    height: 36.8px; width: 206px; border-radius: 10px;
                    background: download-ta.has-hover ? Theme.sys-control : transparent;
                    download-ta := TouchArea { mouse-cursor: pointer; clicked => { AppState.runtime-action("download", AppState.open-menu-song-id, ""); AppState.open-menu-song-id = -1; } }
                    Text { x: 10px; height: parent.height; text: "下载歌曲"; font-size: 13px; color: Theme.sys-text; vertical-alignment: center; }
                }
                // 添加到歌单主项 (.menu-item: width 206px, height 36.8px, border-radius 10px, transition background 0.15s)
                context-menu-item-add := Rectangle {
                    width: 206px;
                    height: 36.8px;
                    border-radius: 10px;
                    background: AppState.open-menu-submenu
                        ? Theme.sys-control-active
                        : (add-ta.has-hover ? Theme.sys-control : transparent);
                    animate background { duration: 150ms; easing: ease; }

                    add-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppState.open-menu-submenu = !AppState.open-menu-submenu;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        AppIcon {
                            y: (parent.height - self.height) / 2;
                            source: Icons.plus;
                            icon-size: 14px;
                            tint: Theme.sys-text-tertiary;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: "添加到歌单";
                            font-size: 13px;
                            color: Theme.sys-text;
                            vertical-alignment: center;
                        }

                        AppIcon {
                            y: (parent.height - self.height) / 2;
                            source: AppState.open-menu-submenu ? Icons.chevron-down : Icons.chevron-right;
                            icon-size: 12px;
                            tint: Theme.sys-text-disabled;
                        }
                    }
                }

                // 展开的子歌单列表 (.playlist-submenu: transition background 0.15s)
                if AppState.open-menu-submenu : submenu-scroll := Flickable {
                    height: Math.min(AppState.created-playlists.length * 40px + 4px, 244px);
                    content-width: self.width;
                    content-height: submenu-rows.height + 4px;
                    submenu-rows := VirtualRows {
                        y: 2px;
                        width: parent.width;
                        row-count: AppState.created-playlists.length;
                        row-height: 40px;
                        viewport-top: -submenu-scroll.content-y - 2px;
                        viewport-height: submenu-scroll.height;
                        for offset in submenu-rows.slot-count : Rectangle {
                            property <int> target-index: submenu-rows.row-index(offset);
                            property <int> item-index: -1;
                            init => { self.item-index = self.target-index; }
                            changed target-index => { self.item-index = self.target-index; }
                            visible: item-index < submenu-rows.end-row;
                            property <NavPlaylistItem> pl: AppState.created-playlists[item-index];
                            y: (item-index) * submenu-rows.row-height;
                            width: parent.width;
                            height: 40px;
                            border-radius: 8px;
                            background: sub-ta.has-hover ? Theme.sys-control : transparent;
                            animate background { duration: 150ms; easing: ease; }

                            sub-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if AppState.runtime-enabled { AppState.runtime-action("add-track", pl.id, ""); }
                                    AppState.open-menu-song-id = -1;
                                }
                            }

                            HorizontalLayout {
                                padding-left: 32px;
                                padding-right: 10px;
                                spacing: 8px;

                                RoundedCover {
                                    width: 28px;
                                    height: 28px;
                                    y: (parent.height - self.height) / 2;
                                    radius: 6px;
                                    source: pl.cover;
                                    cover-id: pl.id;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: pl.name;
                                    font-size: 12px;
                                    color: Theme.sys-text-secondary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Text {
                                    text: pl.track-count + "首";
                                    font-size: 11px;
                                    color: Theme.sys-text-disabled;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // 分割线 (.menu-divider: margin 4px 10px, height 1px) + 从歌单删除 (.remove-item)
                if AppState.open-menu-show-remove : VerticalLayout {
                    spacing: 0px;

                    Rectangle { height: 4px; }
                    Rectangle {
                        x: 10px;
                        width: 186px;
                        height: 1px;
                        background: Theme.sys-border;
                    }
                    Rectangle { height: 4px; }

                    Rectangle {
                        width: 206px;
                        height: 36.8px;
                        border-radius: 10px;
                        background: rem-ta.has-hover ? Theme.sys-danger-soft : transparent;
                        animate background { duration: 150ms; easing: ease; }

                        rem-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if AppState.runtime-enabled { AppState.runtime-action("remove-track", AppState.open-menu-song-id, ""); }
                                AppState.open-menu-song-id = -1;
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;

                            AppIcon {
                                y: (parent.height - self.height) / 2;
                                source: Icons.trash-outline;
                                icon-size: 14px;
                                tint: rem-ta.has-hover ? Theme.sys-danger : Theme.sys-text-tertiary;
                            }

                            Text {
                                text: "从歌单删除";
                                font-size: 13px;
                                color: rem-ta.has-hover ? Theme.sys-danger : Theme.sys-text;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// 对应 AddToPlaylistModal.vue (.add-playlist-card: x=527.5, y=272.41, width 380px, height 455.19px, border-radius 28px)
export component AddToPlaylistModal inherits Rectangle {
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.30);

    TouchArea {
        clicked => { AppState.is-add-to-playlist-open = false; }
    }

    add-playlist-card := Rectangle {
        width: 380px;
        height: 455.19px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 28px;
        background: Theme.glass-fill-strong;
        border-width: 1px;
        border-color: Theme.glass-border;
        drop-shadow-blur: 48px;
        drop-shadow-offset-y: 22px;
        drop-shadow-color: Theme.glass-shadow-elevated;
        clip: true;

        TouchArea {}

        // 1px border 内部容器 (378 x 453.19)
        Rectangle {
            x: 1px;
            y: 1px;
            width: 378px;
            height: 453.19px;

            // .card-header (x=+0, y=+0, width=378, height=93.19, padding 24px 24px 16px)
            add-playlist-header := Rectangle {
                x: 0px;
                y: 0px;
                width: 378px;
                height: 93.19px;

                VerticalLayout {
                    x: 24px;
                    y: 24px;
                    width: 260px;
                    spacing: 2px;

                    Text {
                        text: "添加到歌单";
                        font-size: 20px;
                        font-weight: 800;
                        color: Theme.sys-text;
                    }

                    Text {
                        text: "「" + AppState.add-to-playlist-song-name + "」";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.sys-text-tertiary;
                        overflow: elide;
                    }
                }

                // .close-btn (x = 378 - 24 - 36 = 318 -> window x = 528.5 + 318 = 846.5, y = 273.41 + 24 = 297.41, 36x36, transition all 0.2s)
                add-playlist-close-btn := Rectangle {
                    x: 318px;
                    y: 24px;
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: close-ta.has-hover ? Theme.sys-control-hover : Theme.sys-control;
                    animate background { duration: 200ms; easing: ease; }

                    close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppState.is-add-to-playlist-open = false; }
                    }

                    AppIcon {
                        x: 8px;
                        y: 8px;
                        source: Icons.close;
                        icon-size: 20px;
                        tint: close-ta.has-hover ? Theme.sys-text : Theme.sys-text-secondary;
                    }
                }
            }

            // .playlist-list (y=93.19, padding 0 16px 20px, scrollbar-gutter: stable -> item width = 378 - 32 - 10 = 336px, x = 528.5 + 16 = 544.5)
            playlist-scroll := Flickable {
                x: 0px;
                y: 93.19px;
                width: 378px;
                height: parent.height - 93.19px;
                content-width: 378px;
                content-height: pl-col.height + (AppState.created-playlists.length > 0 ? 16px : 20px);
                changed content-height => { self.content-y = Math.max(Math.min(0px, self.height - self.content-height), Math.min(0px, self.content-y)); }

                pl-col := VirtualRows {
                    x: 16px;
                    width: 336px;
                    row-count: AppState.created-playlists.length;
                    row-height: 68px;
                    viewport-top: -playlist-scroll.content-y;
                    viewport-height: playlist-scroll.height;

                    for offset in pl-col.slot-count : Rectangle {
                        property <int> target-index: pl-col.row-index(offset);
                        property <int> item-index: -1;
                        init => { self.item-index = self.target-index; }
                        changed target-index => { self.item-index = self.target-index; }
                        visible: item-index < pl-col.end-row;
                        property <NavPlaylistItem> pl: AppState.created-playlists[item-index];
                        y: (item-index) * pl-col.row-height;
                        width: 336px;
                        height: 64px;
                        border-radius: 14px;
                        background: (!pl.already-added && item-ta.has-hover) ? Theme.sys-control : transparent;
                        opacity: pl.already-added ? 0.55 : 1.0;
                        animate background { duration: 200ms; easing: ease; }

                        item-ta := TouchArea {
                            enabled: !pl.already-added;
                            mouse-cursor: pl.already-added ? default : pointer;
                            clicked => {
                                if AppState.runtime-enabled { AppState.runtime-action("add-track", pl.id, ""); }
                                AppState.is-add-to-playlist-open = false;
                            }
                        }

                        // .playlist-cover (x = +12px -> window x = 544.5 + 12 = 556.5, y = +10px -> window y = 366.59 + 10 = 376.59, 44x44, radius 10px)
                        RoundedCover {
                            x: 12px;
                            y: 10px;
                            width: 44px;
                            height: 44px;
                            radius: 10px;
                            source: pl.cover;
                            cover-id: pl.id;
                        }

                        VerticalLayout {
                            x: 68px;
                            y: 12px;
                            width: 210px;
                            spacing: 2px;

                            Text {
                                text: pl.name;
                                font-size: 14px;
                                font-weight: 600;
                                color: Theme.sys-text;
                                overflow: elide;
                            }

                            Text {
                                text: pl.track-count + "首 · 播放" + pl.play-count;
                                font-size: 11px;
                                color: Theme.sys-text-tertiary;
                            }
                        }

                        if pl.already-added : HorizontalLayout {
                            x: 336px - 12px - 60px;
                            y: 0px;
                            width: 60px;
                            height: 64px;
                            spacing: 4px;
                            alignment: end;

                            AppIcon {
                                y: (parent.height - self.height) / 2;
                                source: Icons.check;
                                icon-size: 18px;
                                tint: Theme.sys-success;
                            }

                            Text {
                                text: "已添加";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.sys-text-disabled;
                                vertical-alignment: center;
                            }
                        }

                        if !pl.already-added : AppIcon {
                            x: 336px - 12px - 20px;
                            y: 22px;
                            source: Icons.plus;
                            icon-size: 20px;
                            tint: item-ta.has-hover ? Theme.theme-color : Theme.sys-text-disabled;
                        }
                    }
                }
            }
        }
    }
}

export { LoginModal } from "login_modal.slint";

// 对应 AppDialog.vue (.app-dialog.liquid-glass: x=457.5, y=406, width 520px, height 188px, border-radius 20px, padding 22px, transition opacity 0.18s ease)
export component AppDialogModal inherits Rectangle {
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.18);
    property <bool> active: AppState.is-dialog-open;
    property <bool> confirm-focused: false;
    changed active => {
        if root.active { root.confirm-focused = AppState.dialog-mode != "confirm-cancel"; dialog-focus.focus(); }
    }
    public function cancel() {
        if AppState.playlist-delete-id >= 0 { AppState.playlist-restore-focus = 2; }
        AppState.is-dialog-open = false;
    }
    public function confirm() {
        if AppState.playlist-delete-id >= 0 {
            AppState.confirm-playlist-delete();
        } else if AppState.current-route == "local-music" && AppState.dialog-title == "清空本地音乐" {
            if AppState.runtime-enabled { AppState.runtime-action("local", -1, "clear"); } else { AppState.local-tracks = []; }
        }
        AppState.is-dialog-open = false;
    }
    dialog-focus := FocusScope {
        enabled: root.active;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            if event.text == Key.Tab || event.text == Key.Backtab {
                if AppState.dialog-mode == "confirm-cancel" { root.confirm-focused = !root.confirm-focused; }
                return accept;
            }
            if event.text == "\n" || event.text == " " {
                if root.confirm-focused { root.confirm(); } else { root.cancel(); }
                return accept;
            }
            return reject;
        }
    }

    TouchArea {
        clicked => { root.cancel(); }
    }

    app-dialog := Rectangle {
        width: Math.min(520px, parent.width - 40px);
        height: 188px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 20px;
        background: Theme.glass-fill-strong;
        border-width: 1px;
        border-color: Theme.glass-border;
        drop-shadow-blur: 48px;
        drop-shadow-offset-y: 22px;
        drop-shadow-color: Theme.glass-shadow-elevated;

        TouchArea {}

        // 1px border + 22px padding -> inner x=+23px, y=+23px, width=474px, height=142px
        Rectangle {
            x: 23px;
            y: 23px;
            width: parent.width - 46px;
            height: parent.height - 46px;

            VerticalLayout {
                x: 0px;
                y: 0px;
                width: 100%;
                spacing: 8px;

                Text {
                    text: AppState.dialog-title;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.sys-text;
                }

                Text {
                    text: AppState.dialog-message;
                    font-size: 14px;
                    color: Theme.sys-text-secondary;
                    wrap: word-wrap;
                }
            }

            // .dialog-actions (y = 142 - 40 = 102px -> window y = 406 + 23 + 102 = 531px, gap 8px, btn width 76px, height 40px)
            if AppState.dialog-mode == "confirm-cancel" : dialog-secondary-btn := Rectangle {
                x: parent.width - 76px - 8px - 76px;
                y: 102px;
                width: 76px;
                height: 40px;
                border-radius: 20px;
                background: cancel-ta.has-hover ? Theme.sys-control-hover : Theme.sys-control;
                border-width: dialog-focus.has-focus && !root.confirm-focused ? 1px : 0px;
                border-color: Theme.theme-color;
                accessible-role: button;
                accessible-label: AppState.dialog-cancel-text;
                accessible-action-default => { root.cancel(); }

                cancel-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.cancel(); }
                }

                Text {
                    text: AppState.dialog-cancel-text;
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.sys-text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            dialog-primary-btn := Rectangle {
                x: parent.width - 76px;
                y: 102px;
                width: 76px;
                height: 40px;
                border-radius: 20px;
                background: ok-ta.has-hover ? Theme.theme-color-strong : Theme.theme-color;
                border-width: dialog-focus.has-focus && root.confirm-focused ? 2px : 0px;
                border-color: Theme.theme-color-strong;
                accessible-role: button;
                accessible-label: AppState.dialog-confirm-text;
                accessible-action-default => { root.confirm(); }

                ok-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.confirm();
                    }
                }

                Text {
                    text: AppState.dialog-confirm-text;
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.sys-on-accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component DownloadModal inherits Rectangle {
    background: rgba(0, 0, 0, 0.22);
    TouchArea { clicked => { AppState.is-download-open = false; } }
    Rectangle {
        width: 460px; height: 440px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        background: Theme.glass-fill-strong; border-radius: 20px;
        border-width: 1px; border-color: Theme.glass-border;
        TouchArea {}
        Text { x: 24px; y: 22px; width: 375px; text: "下载 · " + AppState.download-song-name; font-size: 18px; font-weight: 700; color: Theme.sys-text; overflow: elide; }
        Rectangle {
            x: parent.width - 50px; y: 18px; width: 32px; height: 32px;
            AppIcon { x: 8px; y: 8px; source: Icons.close; icon-size: 16px; tint: Theme.sys-text-secondary; }
            TouchArea { mouse-cursor: pointer; clicked => { AppState.is-download-open = false; } }
        }
        if AppState.download-qualities.length == 0 : Text { x: 24px; y: 90px; text: "正在获取当前账号可下载音质…"; font-size: 13px; color: Theme.sys-text-secondary; }
        VerticalLayout {
            x: 20px; y: 70px; width: parent.width - 40px; spacing: 4px;
            for option in AppState.download-qualities : Rectangle {
                height: 44px; border-radius: 10px;
                background: quality-ta.has-hover && option.available ? Theme.sys-control-hover : transparent;
                quality-ta := TouchArea { enabled: option.available; mouse-cursor: option.available ? pointer : not-allowed; clicked => { AppState.runtime-action("save-download", AppState.download-song-id, option.quality); } }
                Text { x: 12px; height: parent.height; width: 130px; text: option.label; font-size: 14px; color: option.available ? Theme.sys-text : Theme.sys-text-disabled; vertical-alignment: center; }
                Text { x: 145px; height: parent.height; width: parent.width - 157px; text: option.available ? "下载" : option.reason; font-size: 12px; color: option.available ? Theme.theme-color : Theme.sys-text-tertiary; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
            }
        }
    }
}
