import { PlaylistState } from "../state/playlist.slint";
import { FlowText } from "../components/typography.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";

import { AppIcon, RoundedCover } from "../components/common.slint";

// Shared keyboard/accessibility behavior; dimensions remain specific to each Vue dialog.
component PlaylistDescriptionField inherits Rectangle {
    in property <bool> editing;
    out property <bool> input-focused: description-input.has-focus;
    public function focus-input() { description-input.focus(); }
    visible: root.editing;
    height: root.editing ? description-heading.preferred-height + 8px + description-box.height : 0px;
    description-heading := HorizontalLayout {
        x: 0px; y: 0px; height: self.preferred-height;
        width: root.width; spacing: 8px; cross-axis-alignment: center;
        FlowText { text: "简介"; font-size: 13px; color: Theme.sys-text-secondary; }
        FlowText { text: "选填"; font-size: 11px; color: Theme.sys-text-tertiary; }
        Rectangle { horizontal-stretch: 1; }
        FlowText { text: PlaylistState.playlist-editor-description-length + " / 1000"; font-size: 11px; color: Theme.sys-text-tertiary; }
    }
    description-box := Rectangle {
        y: description-heading.preferred-height + 8px; width: 100%; height: 112px;
        border-radius: 10px; border-width: 1px;
        border-color: description-input.has-focus ? Theme.theme-color : Theme.sys-border;
        background: Theme.sys-control;
        if PlaylistState.playlist-editor-description == "" : Text {
            x: 14px; y: 12px; text: "记录这份歌单的心情、故事或灵感…";
            font-size: 13px; color: Theme.sys-text-tertiary;
        }
        Flickable {
            x: 14px; y: 12px; width: parent.width - 28px; height: parent.height - 24px;
            content-width: self.width;
            content-height: Math.max(self.height, description-input.preferred-height);
            description-input := TextInput {
                x: 0px; y: 0px;
                width: parent.width; height: Math.max(parent.height, self.preferred-height);
                text <=> PlaylistState.playlist-editor-description;
                wrap: word-wrap; font-size: 13px; color: Theme.sys-text;
                enabled: root.editing;
                accessible-label: "歌单简介";
                edited => { PlaylistState.playlist-input-changed(); }
            }
        }
    }
}

export component PlaylistButton inherits Rectangle {
    preferred-width: label-measure.preferred-width + 40px;
    label-measure := Text { visible: false; text: root.label; font-size: 13px; font-weight: 600; }
    in property <string> label;
    in property <image> icon;
    in property <length> icon-size: 18px;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> filled: false;
    in property <bool> menu-item: false;
    out property <bool> has-focus: focus.has-focus;
    callback clicked();
    forward-focus: focus;
    opacity: root.enabled ? 1 : 0.45;
    background: root.primary ? (touch.has-hover ? Theme.theme-color-strong : Theme.theme-color)
        : touch.has-hover || focus.has-focus ? (root.danger ? Theme.sys-danger-soft : Theme.sys-control-hover)
        : root.filled ? Theme.sys-control : transparent;
    animate background { duration: 150ms; easing: ease; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { focus.focus(); root.clicked(); }
    }
    if root.icon.width > 0 : AppIcon {
        x: root.menu-item ? 12px : (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        icon-size: root.icon-size;
        tint: root.danger ? Theme.sys-danger : Theme.sys-text-secondary;
    }
    if root.icon.width == 0 || root.menu-item : Text {
        x: root.menu-item ? 39px : 0px;
        width: parent.width - self.x;
        height: 100%;
        text: root.label;
        font-size: 13px;
        font-weight: root.menu-item ? 400 : 600;
        color: root.primary ? Theme.sys-on-accent : root.danger ? Theme.sys-danger : Theme.sys-text-secondary;
        horizontal-alignment: root.menu-item ? left : center;
        vertical-alignment: center;
    }
}

component PlaylistEditorFooter inherits Rectangle {
    in property <bool> editing;
    out property <bool> cancel-focused: cancel-button.has-focus;
    out property <bool> submit-focused: submit-button.has-focus;
    public function focus-cancel() { cancel-button.focus(); }
    public function focus-submit() { submit-button.focus(); }
    height: footer-actions.preferred-height;
    background: root.editing ? Theme.sys-bg-soft : transparent;
    if root.editing : Rectangle { x: 0px; y: 0px; height: 1px; width: 100%; background: Theme.sys-border; }
    footer-actions := HorizontalLayout {
        width: root.width;
        padding-left: 24px; padding-right: 24px;
        padding-top: 16px; padding-bottom: 20px;
        spacing: root.editing ? 14px : 10px; alignment: end;
        cancel-button := PlaylistButton {
            height: root.editing ? 36px : 40px;
            border-radius: root.editing ? 9px : 20px;
            border-width: root.editing ? 0px : 1px; border-color: Theme.sys-border;
            filled: !root.editing; label: "取消";
            clicked => { PlaylistState.close-playlist-editor(); }
        }
        submit-button := PlaylistButton {
            height: root.editing ? 36px : 40px;
            border-radius: root.editing ? 9px : 20px;
            primary: true; enabled: PlaylistState.playlist-editor-can-submit;
            label: root.editing ? "保存修改" : "创建";
            clicked => { PlaylistState.submit-playlist(); }
        }
    }
}

component PlaylistEditorHeader inherits Rectangle {
    in property <bool> editing;
    out property <bool> close-focused: close-button.has-focus;
    public function focus-close() { close-button.focus(); }
    height: header-content.preferred-height;
    header-content := HorizontalLayout {
        width: root.width;
        padding-left: root.editing ? 28px : 24px;
        padding-right: root.editing ? 28px : 24px;
        padding-top: 24px; padding-bottom: 16px; spacing: 12px;
        cross-axis-alignment: start;
        VerticalLayout {
            horizontal-stretch: 1; spacing: 2px;
            FlowText { text: root.editing ? "编辑歌单" : "新建歌单"; font-size: root.editing ? 19px : 20px; font-weight: root.editing ? 700 : 800; color: Theme.sys-text; }
            if !root.editing : FlowText { text: "创建后可在侧边栏直接找到"; font-size: 12px; font-weight: 600; color: Theme.sys-text-tertiary; wrap: word-wrap; }
        }
        close-button := PlaylistButton {
            width: root.editing ? 28px : 36px;
            height: self.width; border-radius: self.width / 2;
            label: "关闭"; icon: Icons.close;
            icon-size: root.editing ? 18px : 20px; filled: true;
            clicked => { PlaylistState.close-playlist-editor(); }
        }
    }
}

component PlaylistEditorForm inherits VerticalLayout {
    in property <bool> editing;
    out property <bool> name-focused: name-input.has-focus;
    out property <bool> description-focused: description-field.input-focused;
    out property <bool> privacy-focused: privacy-focus.has-focus;
    public function focus-name() { name-input.focus(); }
    public function select-name() { name-input.select-all(); }
    public function focus-description() { description-field.focus-input(); }
    public function focus-privacy() { privacy-focus.focus(); }

    padding-left: root.editing ? 28px : 24px;
    padding-right: root.editing ? 28px : 24px;
    padding-bottom: 20px; spacing: 0px;
    if root.editing : HorizontalLayout {
        spacing: 14px; cross-axis-alignment: center;
        preview-cover := RoundedCover {
            width: 64px; height: 64px; radius: 10px;
            source: PlaylistState.playlist-cover; is-local-fallback: PlaylistState.playlist-cover.width == 0;
        }
        VerticalLayout {
            horizontal-stretch: 1; spacing: 4px;
            FlowText { text: PlaylistState.playlist-title; font-size: 15px; font-weight: 600; color: Theme.sys-text; overflow: elide; }
            FlowText { text: "歌单 · " + PlaylistState.playlist-track-count + " 首歌曲"; font-size: 12px; color: Theme.sys-text-tertiary; }
        }
    }
    Rectangle { height: root.editing ? 24px : 0px; }
    name-field := Rectangle {
        height: name-heading.preferred-height + 8px + name-box.height;
        name-heading := HorizontalLayout {
            x: 0px; y: 0px; height: self.preferred-height;
            width: root.editing ? root.width - 56px : root.width - 48px;
            spacing: 12px; cross-axis-alignment: center;
            FlowText {
                text: root.editing ? "名称" : "歌单名称";
                font-size: root.editing ? 13px : 12px;
                font-weight: root.editing ? 400 : 600;
                color: Theme.sys-text-secondary; horizontal-stretch: 1;
            }
            if root.editing : FlowText {
                text: PlaylistState.playlist-editor-name-length + " / 40";
                font-size: 11px; color: Theme.sys-text-tertiary;
            }
        }
        name-box := Rectangle {
            y: name-heading.preferred-height + 8px; width: 100%; height: 44px;
            border-radius: root.editing ? 10px : 14px;
            border-width: 1px;
            border-color: name-input.has-focus ? Theme.theme-color : Theme.sys-border;
            background: !root.editing && name-input.has-focus ? Theme.sys-control-hover : Theme.sys-control;
            animate border-color, background { duration: 150ms; }
            if PlaylistState.playlist-editor-name == "" : Text {
                x: 14px; width: parent.width - 28px; height: 100%;
                text: root.editing ? "给歌单起个名字" : "比如「深夜循环」";
                font-size: root.editing ? 13px : 14px;
                color: Theme.sys-text-tertiary; vertical-alignment: center;
            }
            name-input := TextInput {
                x: 14px; width: parent.width - 28px; height: 100%;
                text <=> PlaylistState.playlist-editor-name;
                single-line: true; font-size: root.editing ? 13px : 14px;
                color: Theme.sys-text; vertical-alignment: center;
                accessible-label: "歌单名称";
                edited => { PlaylistState.playlist-input-changed(); }
                accepted => { PlaylistState.submit-playlist(); }
            }
        }
    }
    Rectangle { height: root.editing ? 20px : 16px; }
    description-field := PlaylistDescriptionField {
        editing: root.editing;
    }
    privacy-row := Rectangle {
        visible: !root.editing;
        height: root.editing ? 0px : Math.max(privacy-info.preferred-height, privacy-toggle.height);
        privacy-info := VerticalLayout {
            x: 0px; height: self.preferred-height;
            width: parent.width - 60px; spacing: 2px;
            FlowText { text: "私密歌单"; font-size: 12px; font-weight: 600; color: Theme.sys-text-secondary; }
            FlowText { text: "只有自己可见，不会出现在个人主页"; font-size: 11px; color: Theme.sys-text-tertiary; wrap: word-wrap; }
        }
        privacy-toggle := Rectangle {
            x: parent.width - 44px; y: (parent.height - self.height) / 2; width: 44px; height: 26px;
            border-radius: 13px;
            background: PlaylistState.playlist-editor-private ? Theme.theme-color : Theme.sys-control-hover;
            animate background { duration: 200ms; }
            border-width: privacy-focus.has-focus ? 1px : 0px;
            border-color: Theme.theme-color;
            accessible-role: checkbox;
            accessible-label: "私密歌单";
            accessible-checked: PlaylistState.playlist-editor-private;
            accessible-action-default => { PlaylistState.playlist-editor-private = !PlaylistState.playlist-editor-private; }
            Rectangle {
                x: PlaylistState.playlist-editor-private ? 21px : 3px; y: 3px;
                width: 20px; height: 20px; border-radius: 10px; background: Theme.sys-surface;
                drop-shadow-blur: 3px; drop-shadow-offset-y: 1px; drop-shadow-color: #0003;
                animate x { duration: 200ms; easing: ease; }
            }
        }
        privacy-focus := FocusScope {
            enabled: !root.editing;
            key-pressed(event) => {
                if event.text == " " { PlaylistState.playlist-editor-private = !PlaylistState.playlist-editor-private; return accept; }
                return reject;
            }
        }
        TouchArea {
            enabled: !root.editing; mouse-cursor: pointer;
            clicked => { privacy-focus.focus(); PlaylistState.playlist-editor-private = !PlaylistState.playlist-editor-private; }
        }
    }
    if PlaylistState.playlist-editor-error != "" : VerticalLayout {
        padding-top: 16px;
        Rectangle {
            height: error-text.height + 24px;
            border-radius: 10px; background: Theme.sys-danger-soft;
            error-text := FlowText {
                x: 12px; y: 12px; width: parent.width - 24px;
                text: PlaylistState.playlist-editor-error; color: Theme.sys-danger; font-size: 12px; wrap: word-wrap;
            }
        }
    }
}

export component PlaylistActionsOverlay inherits Rectangle {
    property <bool> opened: PlaylistState.is-playlist-actions-open && PlaylistState.playlist-can-manage;
    property <float> reveal: root.opened ? 1 : 0;
    animate reveal { duration: 120ms; easing: ease; }
    property <float> menu-scale: 0.97 + 0.03 * root.reveal;
    opacity: root.reveal;
    visible: root.opened || root.reveal > 0.001;
    changed opened => { if root.opened { edit-button.focus(); } }
    function switch-action-focus() { if edit-button.has-focus { delete-button.focus(); } else { edit-button.focus(); } }
    public function close() { PlaylistState.is-playlist-actions-open = false; PlaylistState.playlist-restore-focus = 2; }
    TouchArea { enabled: root.opened; clicked => { root.close(); } }
    action-menu := Rectangle {
        x: Math.clamp(PlaylistState.playlist-actions-x + 176px - self.width, 8px, parent.width - self.width - 8px);
        y: Math.clamp(PlaylistState.playlist-actions-y, 8px, parent.height - 101px - 8px) - 4px * (1 - root.reveal);
        width: 176px * root.menu-scale; height: 101px * root.menu-scale; border-radius: 14px;
        border-width: 1px; border-color: Theme.glass-border;
        background: Theme.sys-bg-elevated;
        drop-shadow-blur: 44px; drop-shadow-offset-y: 18px; drop-shadow-color: Theme.sys-shadow-elevated;
        TouchArea { enabled: root.opened; }
        FocusScope {
            enabled: root.opened;
            key-pressed(event) => {
                if event.text == Key.Escape { root.close(); return accept; }
                if event.text == Key.DownArrow || event.text == Key.UpArrow {
                    root.switch-action-focus();
                    return accept;
                }
                if event.text == Key.Tab || event.text == Key.Backtab { root.close(); return accept; }
                return reject;
            }
            edit-button := PlaylistButton {
                enabled: root.opened;
                x: 6px * root.menu-scale; y: 6px * root.menu-scale;
                width: 164px * root.menu-scale; height: 40px * root.menu-scale; border-radius: 9px;
                label: "编辑歌单"; icon: Icons.edit; icon-size: 17px; menu-item: true;
                clicked => { PlaylistState.is-playlist-actions-open = false; PlaylistState.open-edit-playlist(); }
            }
            menu-divider := Rectangle { x: 14px * root.menu-scale; y: 50px * root.menu-scale; width: 148px * root.menu-scale; height: 1px; background: Theme.sys-border; }
            delete-button := PlaylistButton {
                enabled: root.opened;
                x: 6px * root.menu-scale; y: 55px * root.menu-scale;
                width: 164px * root.menu-scale; height: 40px * root.menu-scale; border-radius: 9px;
                label: "删除歌单"; icon: Icons.trash-outline; icon-size: 17px; menu-item: true; danger: true;
                clicked => { PlaylistState.is-playlist-actions-open = false; PlaylistState.request-delete-playlist(); }
            }
        }
    }
}

component PlaylistEditorContent inherits FocusScope {
    in property <bool> editing;
    function move-focus(backwards: bool) {
        if backwards {
            if form-content.name-focused { editor-header.focus-close(); }
            else if editor-header.close-focused {
                if PlaylistState.playlist-editor-can-submit { editor-footer.focus-submit(); }
                else { editor-footer.focus-cancel(); }
            }
            else if editor-footer.submit-focused { editor-footer.focus-cancel(); }
            else if editor-footer.cancel-focused {
                if root.editing { form-content.focus-description(); }
                else { form-content.focus-privacy(); }
            }
            else { form-content.focus-name(); }
        } else {
            if form-content.name-focused {
                if root.editing { form-content.focus-description(); }
                else { form-content.focus-privacy(); }
            }
            else if form-content.description-focused || form-content.privacy-focused { editor-footer.focus-cancel(); }
            else if editor-footer.cancel-focused && PlaylistState.playlist-editor-can-submit { editor-footer.focus-submit(); }
            else if editor-header.close-focused { form-content.focus-name(); }
            else { editor-header.focus-close(); }
        }
    }
    preferred-height: editor-header.height + form-content.preferred-height + editor-footer.height;
    init => { form-content.focus-name(); if root.editing { form-content.select-name(); } }
    key-pressed(event) => {
        if event.text == Key.Escape { PlaylistState.close-playlist-editor(); return accept; }
        if event.text == Key.Tab || event.text == Key.Backtab {
            root.move-focus(event.modifiers.shift || event.text == Key.Backtab);
            return accept;
        }
        return reject;
    }

    editor-layout := VerticalLayout {
        x: 1px; y: 1px; width: root.width - 2px; height: root.height - 2px;
        spacing: 0px;
        editor-header := PlaylistEditorHeader {
            editing: root.editing;
        }
        editor-scroll := Flickable {
            vertical-stretch: 1; min-height: 0px;
            content-width: self.width; content-height: form-content.preferred-height;
            form-content := PlaylistEditorForm {
                width: root.width - 2px;
                editing: root.editing;
            }
        }
        editor-footer := PlaylistEditorFooter {
            editing: root.editing;
        }
    }
}

export component PlaylistEditor inherits Rectangle {
    property <bool> editing: PlaylistState.playlist-editor-mode == "edit";
    background: root.editing ? rgba(12, 15, 24, 0.32) : rgba(0, 0, 0, 0.30);
    TouchArea { clicked => { PlaylistState.close-playlist-editor(); } }

    editor-card := Rectangle {
        width: Math.min(root.editing ? 480px : 380px, parent.width - 40px);
        height: Math.min(root.height - 40px,
            modal-focus.preferred-height + 2px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: root.editing ? 22px : 28px;
        border-width: 1px;
        border-color: Theme.glass-border;
        background: root.editing ? Theme.sys-bg-elevated : Theme.glass-fill;
        drop-shadow-blur: 48px;
        drop-shadow-offset-y: 22px;
        drop-shadow-color: Theme.sys-shadow-elevated;
        clip: true;
        TouchArea {}
        modal-focus := PlaylistEditorContent {
            editing: root.editing;
        }
    }
}
