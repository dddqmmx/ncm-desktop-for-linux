{
  "name": "ncm-desktop-for-linux",
  "version": "1.0.0",
  "private": true,
  "description": "A third-party NetEase Cloud Music client for Linux (Slint/Rust client; the Electron client lives in electron/)",
  "scripts": {
    "dev": "npm run dev:slint",
    "build": "npm run build:slint",
    "test": "npm run test:slint",
    "dev:slint": "cargo run --manifest-path slint-ui/Cargo.toml --locked --features hot-reload",
    "build:slint": "cargo build --manifest-path slint-ui/Cargo.toml --release --locked",
    "test:slint": "cargo test --manifest-path slint-ui/Cargo.toml --locked",
    "check:slint": "python3 slint-ui/scripts/check_ui_quality.py",
    "test:native-seek": "node scripts/native-seek-regression.cjs",
    "dev:electron": "npm --prefix electron run dev",
    "build:electron": "npm --prefix electron run build",
    "build:native:dev": "npm --prefix electron run build:native:dev"
  }
}
